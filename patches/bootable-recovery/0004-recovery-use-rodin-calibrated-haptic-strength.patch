--- a/minuitwrp/events.cpp
+++ b/minuitwrp/events.cpp
@@ -192,8 +192,31 @@
         write_to_file(LEDS_HAPTICS_DURATION_FILE, tout);
         write_to_file(LEDS_HAPTICS_ACTIVATE_FILE, "1");
     } else if (std::ifstream(SIH_HAPTICS_ACTIVATE_FILE).good()) {
-        write_to_file(SIH_HAPTICS_DURATION_FILE, tout);
+        int strength = timeout_ms;
+        if (strength < 1) strength = 1;
+        if (strength > 100) strength = 100;
+
+        // Rodin SIH6887 recovery strength range.
+        // 0x1e is the driver baseline; 0x80 is the highest
+        // gain verified successfully during real-device testing.
+        const int min_gain = 0x1e;
+        const int max_gain = 0x80;
+        const int gain =
+            min_gain + ((max_gain - min_gain) * strength + 50) / 100;
+
+        // Effect 7 is rodin's calibrated short granular haptic.
+        write_to_file(SIH_HAPTICS_ACTIVATE_FILE, "0");
+        write_to_file(
+            "/sys/bus/i2c/drivers/sih_haptic_688X/0-006b/effect_id", "7");
         write_to_file(SIH_HAPTICS_ACTIVATE_FILE, "1");
+
+        // activate_store asynchronously restores the driver default gain.
+        // Real-device testing shows a 1 ms settle is sufficient before
+        // applying the requested strength.
+        usleep(1000);
+        write_to_file(
+            "/sys/bus/i2c/drivers/sih_haptic_688X/0-006b/gain",
+            std::to_string(gain));
     } else {
         write_to_file(VIBRATOR_TIMEOUT_FILE, tout);
     }
