 partitionmanager.cpp | 143 +++++++++++++++++++++++++++++--------------
 twrp-functions.cpp   | 105 ++++++++++++++++++++++++++++---
 twrpApex.cpp         |   2 +-
 twrpRepacker.cpp     |  58 ++++++++++++++----
 twrpRepacker.hpp     |   2 +-
 6 files changed, 266 insertions(+), 74 deletions(-)

