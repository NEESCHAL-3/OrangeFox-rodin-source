 bool TWPartitionManager::Check_Pending_Merges() {
-	auto sm = android::snapshot::SnapshotManager::NewForFirstStageMount();
-	if (!sm) {
-		LOGERR("Unable to call snapshot manager\n");
-		return false;
-	}
+	// OrangeFox has already created booted-slot logical mappings. Remove
+	// only those mappings before SnapshotManager recreates the logical and
+	// snapshot devices needed for the pending Virtual A/B update.
+	LOGINFO("unmapping recovery-created logical partitions before snapshot handling\n");
 
 	if (!Unmap_Super_Devices()) {
 		LOGERR("Unable to unmap dynamic partitions.\n");
 		return false;
 	}
 
+	// This is normal recovery userspace, not first-stage init.
+	auto sm = android::snapshot::SnapshotManager::New();
+	if (!sm) {
+		LOGERR("Unable to call snapshot manager\n");
+		return false;
+	}
+
 	auto callback = [&]() -> void {
-		double progress;
+		double progress = 0.0;
 		sm->GetUpdateState(&progress);
 		LOGINFO("waiting for merge to complete: %.2f\n", progress);
 	};
 
-	LOGINFO("checking for merges\n");
+	LOGINFO("checking pending Virtual A/B state after logical partition unmap\n");
+
 	if (!sm->HandleImminentDataWipe(callback)) {
 		LOGERR("Unable to check merge status\n");
 		return false;
 	}
+
+	LOGINFO("pending Virtual A/B state handled successfully\n");
 	return true;
 }
 
diff --git a/twrp-functions.cpp b/twrp-functions.cpp
index fd46b07f..f02b15dc 100755
--- a/twrp-functions.cpp
+++ b/twrp-functions.cpp
@@ -5133,17 +5133,96 @@ void TWFunc::FoxThemeCheck()
 
 bool TWFunc::IsRecoveryOverwritten(bool only_update) {
 	static std::pair<string, string> previous_checksums;
-	TWPartition* target_partition = PartitionManager.Find_Partition_By_Path("/boot");
-#if defined(FOX_VENDOR_BOOT_RECOVERY) || defined(BOARD_MOVE_RECOVERY_RESOURCES_TO_VENDOR_BOOT)
-	target_partition = PartitionManager.Find_Partition_By_Path("/vendor_boot");
+
+	// On virtual A/B vendor_boot recovery devices, payload.bin writes the
+	// slot opposite the one from which recovery is currently running.
+	// Temporarily point PartitionManager at that OTA target slot while taking
+	// both the before and after checksums. Restore its original selection
+	// immediately afterwards so mounts and other recovery operations are not
+	// disturbed.
+	string saved_partition_slot;
+	bool switched_partition_slot = false;
+
+#if defined(AB_OTA_UPDATER) && \
+    (defined(FOX_VENDOR_BOOT_RECOVERY) || \
+     defined(BOARD_MOVE_RECOVERY_RESOURCES_TO_VENDOR_BOOT))
+	string running_slot =
+		android::base::GetProperty("ro.boot.slot_suffix", "");
+
+	if (running_slot.empty())
+		running_slot =
+			android::base::GetProperty("ro.boot.slot", "");
+
+	string ota_target_slot;
+
+	if (running_slot == "_a" || running_slot == "a")
+		ota_target_slot = "B";
+	else if (running_slot == "_b" || running_slot == "b")
+		ota_target_slot = "A";
+
+	saved_partition_slot =
+		PartitionManager.Get_Active_Slot_Display();
+
+	if (!ota_target_slot.empty() &&
+	    (saved_partition_slot == "A" ||
+	     saved_partition_slot == "B")) {
+		LOGINFO(
+			"%s: checking OTA target slot %s "
+			"while recovery is running from %s\n",
+			__func__,
+			ota_target_slot.c_str(),
+			running_slot.c_str());
+
+		if (saved_partition_slot != ota_target_slot) {
+			PartitionManager.Override_Active_Slot(
+				ota_target_slot);
+			PartitionManager.Update_System_Details();
+			switched_partition_slot = true;
+		}
+	} else {
+		LOGINFO(
+			"%s: unable to resolve the OTA target slot; "
+			"using the current partition mapping\n",
+			__func__);
+	}
 #endif
+
+	auto restore_partition_slot = [&]() {
+		if (switched_partition_slot) {
+			PartitionManager.Override_Active_Slot(
+				saved_partition_slot);
+			PartitionManager.Update_System_Details();
+		}
+	};
+
+	TWPartition* target_partition =
+		PartitionManager.Find_Partition_By_Path("/boot");
+
+#if defined(FOX_VENDOR_BOOT_RECOVERY) || \
+    defined(BOARD_MOVE_RECOVERY_RESOURCES_TO_VENDOR_BOOT)
+	target_partition =
+		PartitionManager.Find_Partition_By_Path("/vendor_boot");
+#endif
+
 #ifdef OF_AB_DEVICE_WITH_RECOVERY_PARTITION
-	target_partition = PartitionManager.Find_Partition_By_Path("/recovery");
+	target_partition =
+		PartitionManager.Find_Partition_By_Path("/recovery");
 #endif
-	if (!target_partition)
+
+	if (!target_partition) {
+		restore_partition_slot();
 		return false;
+	}
+
+	const string target_mount_point =
+		target_partition->Get_Mount_Point();
+
+	std::pair<string, string> current_checksums =
+		PartitionManager.Get_Partition_Checksums(
+			target_partition);
+
+	restore_partition_slot();
 
-	std::pair<string, string> current_checksums = PartitionManager.Get_Partition_Checksums(target_partition);
 	if (current_checksums.first.empty()) {
 		LOGINFO("%s: Cannot get checksums\n", __func__);
 		return false;
@@ -5154,13 +5233,21 @@ bool TWFunc::IsRecoveryOverwritten(bool only_update) {
 		return false;
 	}
 
-	if (previous_checksums.first.empty() || previous_checksums == current_checksums) {
+	if (previous_checksums.first.empty() ||
+	    previous_checksums == current_checksums) {
 		previous_checksums = current_checksums;
-		LOGINFO("%s: The checksums match for %s\n", __func__, target_partition->Get_Mount_Point().c_str());
+		LOGINFO(
+			"%s: The checksums match for %s\n",
+			__func__,
+			target_mount_point.c_str());
 		return false;
 	}
 
-	LOGINFO("%s: The checksums do not match for %s\n", __func__, target_partition->Get_Mount_Point().c_str());
+	LOGINFO(
+		"%s: The checksums do not match for %s\n",
+		__func__,
+		target_mount_point.c_str());
+
 	return true;
 }
 
