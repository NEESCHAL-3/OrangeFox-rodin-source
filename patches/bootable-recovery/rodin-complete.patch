+		KC_FLASHLIGHT,
+	};
+
 	enum action_state_enum {
 		AS_IN_ACTION_AREA = 0, // we've touched a spot with an action
 		AS_NO_ACTION = 1,    // we've touched in an empty area (no action) and ignore remaining events until touch release
 	};
