+Value* DeleteFn(const char* name, State* state,
+                const std::vector<std::unique_ptr<Expr>>& argv) {
+  if (argv.empty()) {
+    return ErrorAbort(state, kArgsParsingFailure,
+                      "%s() expects at least 1 argument", name);
+  }
+
+  std::vector<std::string> args;
+  if (!ReadArgs(state, argv, &args)) {
+    return ErrorAbort(state, kArgsParsingFailure,
+                      "%s(): failed to parse arguments", name);
+  }
+
+  const bool recursive = (std::string(name) == "delete_recursive");
+  int success = 0;
+
+  for (const auto& path : args) {
+    int rc;
+
+    if (recursive) {
+      rc = dirUnlinkHierarchy(path.c_str());
+    } else {
+      rc = unlink(path.c_str());
+    }
+
+    if (rc == 0) {
+      ++success;
+    } else {
+      PLOG(WARNING) << name << ": failed to remove " << path;
+    }
+  }
+
+  return StringValue(std::to_string(success));
+}
+
+bool ExtractPackageRecursiveCompat(ZipArchiveHandle zip,
+                                   const std::string& zip_path,
+                                   const std::string& dest_path,
+                                   const struct utimbuf* timestamp) {
+  if (!zip_path.empty() && zip_path.front() == '/') {
+    LOG(ERROR) << "package_extract_dir: zip path must be relative: "
+               << zip_path;
+    return false;
+  }
+
+  if (dest_path.empty() || dest_path.front() != '/') {
+    LOG(ERROR) << "package_extract_dir: destination must be absolute: "
+               << dest_path;
+    return false;
+  }
+
+  std::string target_dir = dest_path;
+  if (target_dir.back() != '/') {
+    target_dir += '/';
+  }
+
+  std::string prefix = zip_path;
+  if (!prefix.empty() && prefix.back() != '/') {
+    prefix += '/';
+  }
+
+  void* cookie = nullptr;
+
+  if (StartIteration(zip, &cookie, prefix) != 0) {
+    LOG(ERROR) << "package_extract_dir: failed to iterate ZIP";
+    return false;
+  }
+
+  std::unique_ptr<void, decltype(&EndIteration)>
+      guard(cookie, EndIteration);
+
+  ZipEntry entry;
+  std::string name;
+
+  while (Next(cookie, &entry, &name) == 0) {
+    if (name.size() < prefix.size()) {
+      LOG(ERROR) << "package_extract_dir: malformed ZIP entry";
+      return false;
+    }
+
+    std::string relative = name.substr(prefix.size());
+
+    if (relative.empty()) {
+      continue;
+    }
+
+    // Ignore directory entries. Parent directories are created below.
+    if (relative.back() == '/') {
+      continue;
+    }
+
+    // Don't allow an archive entry to escape the destination.
+    if (relative == ".." ||
+        relative.rfind("../", 0) == 0 ||
+        relative.find("/../") != std::string::npos) {
+      LOG(ERROR) << "package_extract_dir: unsafe entry " << name;
+      return false;
+    }
+
+    std::string path = target_dir + relative;
+
+    if (dirCreateHierarchy(path.c_str(), 0755, timestamp,
+                           true, nullptr) != 0) {
+      PLOG(ERROR) << "package_extract_dir: cannot create parents for "
+                  << path;
+      return false;
+    }
+
+    android::base::unique_fd fd(
+        TEMP_FAILURE_RETRY(open(path.c_str(),
+                                O_CREAT | O_WRONLY | O_TRUNC,
+                                0644)));
+
+    if (fd == -1) {
+      PLOG(ERROR) << "package_extract_dir: cannot create " << path;
+      return false;
+    }
+
+    int rc = ExtractEntryToFile(zip, &entry, fd);
+
+    if (rc != 0) {
+      LOG(ERROR) << "package_extract_dir: extraction failed for "
+                 << path << ": " << ErrorCodeString(rc);
+      return false;
+    }
+
+    if (fsync(fd) != 0) {
+      PLOG(ERROR) << "package_extract_dir: fsync failed for " << path;
+      return false;
+    }
+
+    if (timestamp != nullptr && utime(path.c_str(), timestamp) != 0) {
+      PLOG(ERROR) << "package_extract_dir: utime failed for " << path;
+      return false;
+    }
+  }
+
+  return true;
+}
+
+Value* PackageExtractDirFn(
+    const char* name, State* state,
+    const std::vector<std::unique_ptr<Expr>>& argv) {
+  if (argv.size() != 2) {
+    return ErrorAbort(state, kArgsParsingFailure,
+                      "%s() expects 2 arguments, got %zu",
+                      name, argv.size());
+  }
+
+  std::vector<std::string> args;
+  if (!ReadArgs(state, argv, &args)) {
+    return ErrorAbort(state, kArgsParsingFailure,
+                      "%s(): failed to parse arguments", name);
+  }
+
+  ZipArchiveHandle zip = state->updater->GetPackageHandle();
+
+  // Traditional updater timestamp: 2008-08-01.
+  constexpr struct utimbuf timestamp = {
+      1217592000,
+      1217592000,
+  };
+
+  bool ok = ExtractPackageRecursiveCompat(
+      zip, args[0], args[1], &timestamp);
+
+  return StringValue(ok ? "t" : "");
+}
+
+Value* SymlinkFn(const char* name, State* state,
+                 const std::vector<std::unique_ptr<Expr>>& argv) {
+  if (argv.size() < 2) {
+    return ErrorAbort(state, kArgsParsingFailure,
+                      "%s() expects at least 2 arguments, got %zu",
+                      name, argv.size());
+  }
+
+  std::vector<std::string> args;
+  if (!ReadArgs(state, argv, &args)) {
+    return ErrorAbort(state, kArgsParsingFailure,
+                      "%s(): failed to parse arguments", name);
+  }
+
+  const std::string& target = args[0];
+
+  if (target.empty()) {
+    return ErrorAbort(state, kSymlinkFailure,
+                      "%s(): empty target", name);
+  }
+
+  for (size_t i = 1; i < args.size(); ++i) {
+    const std::string& link_path = args[i];
+
+    if (link_path.empty()) {
+      return ErrorAbort(state, kSymlinkFailure,
+                        "%s(): empty link path", name);
+    }
+
+    if (unlink(link_path.c_str()) != 0 && errno != ENOENT) {
+      return ErrorAbort(state, kSymlinkFailure,
+                        "%s(): failed to remove %s: %s",
+                        name, link_path.c_str(), strerror(errno));
+    }
+
+    if (mkdir_recursively(link_path, 0755, true, nullptr) != 0) {
+      return ErrorAbort(state, kSymlinkFailure,
+                        "%s(): failed creating parents for %s: %s",
+                        name, link_path.c_str(), strerror(errno));
+    }
+
+    if (symlink(target.c_str(), link_path.c_str()) != 0) {
+      return ErrorAbort(state, kSymlinkFailure,
+                        "%s(): failed creating %s -> %s: %s",
+                        name, link_path.c_str(), target.c_str(),
+                        strerror(errno));
+    }
+  }
+
+  return StringValue("t");
+}
+
+struct PermArgs {
+  bool has_uid = false;
+  bool has_gid = false;
+  bool has_mode = false;
+  bool has_dmode = false;
+  bool has_fmode = false;
+  bool has_capabilities = false;
+  bool has_selabel = false;
+
+  uid_t uid = 0;
+  gid_t gid = 0;
+  mode_t mode = 0;
+  mode_t dmode = 0;
+  mode_t fmode = 0;
+  uint64_t capabilities = 0;
+  std::string selabel;
+};
+
+bool ParseUintCompat(State* state, const char* key,
+                     const std::string& value, uint64_t* out) {
+  if (!android::base::ParseUint(value, out)) {
+    state->updater->UiPrint(
+        android::base::StringPrintf(
+            "set_metadata: invalid %s \"%s\"",
+            key, value.c_str()));
+    return false;
+  }
+
+  return true;
+}
+
+bool ParsePermArgs(State* state,
+                   const std::vector<std::string>& args,
+                   PermArgs* parsed) {
+  if ((args.size() % 2) != 0) {
+    state->updater->UiPrint(
+        "set_metadata: permission arguments must be key/value pairs");
+    return false;
+  }
+
+  for (size_t i = 0; i < args.size(); i += 2) {
+    const std::string& key = args[i];
+    const std::string& value = args[i + 1];
+
+    uint64_t number = 0;
+
+    if (key == "uid") {
+      if (!ParseUintCompat(state, "uid", value, &number)) return false;
+      parsed->uid = static_cast<uid_t>(number);
+      parsed->has_uid = true;
+
+    } else if (key == "gid") {
+      if (!ParseUintCompat(state, "gid", value, &number)) return false;
+      parsed->gid = static_cast<gid_t>(number);
+      parsed->has_gid = true;
+
+    } else if (key == "mode") {
+      if (!ParseUintCompat(state, "mode", value, &number)) return false;
+      parsed->mode = static_cast<mode_t>(number);
+      parsed->has_mode = true;
+
+    } else if (key == "dmode") {
+      if (!ParseUintCompat(state, "dmode", value, &number)) return false;
+      parsed->dmode = static_cast<mode_t>(number);
+      parsed->has_dmode = true;
+
+    } else if (key == "fmode") {
+      if (!ParseUintCompat(state, "fmode", value, &number)) return false;
+      parsed->fmode = static_cast<mode_t>(number);
+      parsed->has_fmode = true;
+
+    } else if (key == "capabilities") {
+      if (!ParseUintCompat(state, "capabilities", value, &number)) {
+        return false;
+      }
+      parsed->capabilities = number;
+      parsed->has_capabilities = true;
+
+    } else if (key == "selabel") {
+      parsed->selabel = value;
+      parsed->has_selabel = true;
+
+    } else {
+      state->updater->UiPrint(
+          android::base::StringPrintf(
+              "set_metadata: unknown key \"%s\"",
+              key.c_str()));
+      return false;
+    }
+  }
+
+  return true;
+}
+
+int ApplyCapabilities(const char* filename, uint64_t capabilities) {
+  if (capabilities == 0) {
+    if (removexattr(filename, XATTR_NAME_CAPS) != 0 &&
+        errno != ENODATA &&
+        errno != ENOTSUP &&
+        errno != EOPNOTSUPP) {
+      return -1;
+    }
+    return 0;
+  }
+
+  struct vfs_cap_data cap_data {};
+  cap_data.magic_etc =
+      VFS_CAP_REVISION_2 | VFS_CAP_FLAGS_EFFECTIVE;
+
+  cap_data.data[0].permitted =
+      static_cast<uint32_t>(capabilities & 0xffffffffULL);
+
+  cap_data.data[0].inheritable = 0;
+
+  cap_data.data[1].permitted =
+      static_cast<uint32_t>((capabilities >> 32) & 0xffffffffULL);
+
+  cap_data.data[1].inheritable = 0;
+
+  return setxattr(filename, XATTR_NAME_CAPS,
+                  &cap_data, sizeof(cap_data), 0);
+}
+
+int ApplyParsedPerms(State* state,
+                     const char* filename,
+                     const struct stat* st,
+                     const PermArgs& parsed) {
+  int bad = 0;
+
+  if (parsed.has_selabel) {
+    if (lsetfilecon(filename, parsed.selabel.c_str()) != 0) {
+      state->updater->UiPrint(
+          android::base::StringPrintf(
+              "set_metadata: lsetfilecon failed on %s: %s",
+              filename, strerror(errno)));
+      ++bad;
+    }
+  }
+
+  uid_t uid = parsed.has_uid ? parsed.uid : static_cast<uid_t>(-1);
+  gid_t gid = parsed.has_gid ? parsed.gid : static_cast<gid_t>(-1);
+
+  if ((parsed.has_uid || parsed.has_gid) &&
+      lchown(filename, uid, gid) != 0) {
+    state->updater->UiPrint(
+        android::base::StringPrintf(
+            "set_metadata: lchown failed on %s: %s",
+            filename, strerror(errno)));
+    ++bad;
+  }
+
+  // chmod/setxattr should not follow symlinks.
+  if (!S_ISLNK(st->st_mode)) {
+    bool apply_mode = false;
+    mode_t wanted_mode = 0;
+
+    if (S_ISDIR(st->st_mode) && parsed.has_dmode) {
+      wanted_mode = parsed.dmode;
+      apply_mode = true;
+    } else if (!S_ISDIR(st->st_mode) && parsed.has_fmode) {
+      wanted_mode = parsed.fmode;
+      apply_mode = true;
+    } else if (parsed.has_mode) {
+      wanted_mode = parsed.mode;
+      apply_mode = true;
+    }
+
+    if (apply_mode && chmod(filename, wanted_mode) != 0) {
+      state->updater->UiPrint(
+          android::base::StringPrintf(
+              "set_metadata: chmod failed on %s: %s",
+              filename, strerror(errno)));
+      ++bad;
+    }
+
+    if (parsed.has_capabilities &&
+        ApplyCapabilities(filename, parsed.capabilities) != 0) {
+      state->updater->UiPrint(
+          android::base::StringPrintf(
+              "set_metadata: capabilities failed on %s: %s",
+              filename, strerror(errno)));
+      ++bad;
+    }
+  }
+
+  return bad;
+}
+
+State* g_recursive_state = nullptr;
+PermArgs g_recursive_perms;
+
+int MetadataWalker(const char* filename,
+                   const struct stat* st,
+                   int,
+                   struct FTW*) {
+  if (g_recursive_state == nullptr || st == nullptr) {
+    return 1;
+  }
+
+  return ApplyParsedPerms(
+      g_recursive_state, filename, st, g_recursive_perms);
+}
+
+Value* SetMetadataFn(
+    const char* name, State* state,
+    const std::vector<std::unique_ptr<Expr>>& argv) {
+  if (argv.size() < 3 || (argv.size() % 2) == 0) {
+    return ErrorAbort(
+        state, kArgsParsingFailure,
+        "%s() expects path followed by key/value pairs",
+        name);
+  }
+
+  std::vector<std::string> args;
+  if (!ReadArgs(state, argv, &args)) {
+    return ErrorAbort(state, kArgsParsingFailure,
+                      "%s(): failed to parse arguments", name);
+  }
+
+  const std::string path = args[0];
+
+  std::vector<std::string> perm_args(
+      args.begin() + 1, args.end());
+
+  PermArgs parsed;
+
+  if (!ParsePermArgs(state, perm_args, &parsed)) {
+    return ErrorAbort(state, kSetMetadataFailure,
+                      "%s(): invalid metadata arguments", name);
+  }
+
+  struct stat st {};
+
+  if (lstat(path.c_str(), &st) != 0) {
+    return ErrorAbort(state, kSetMetadataFailure,
+                      "%s(): lstat failed for %s: %s",
+                      name, path.c_str(), strerror(errno));
+  }
+
+  int bad = 0;
+
+  if (std::string(name) == "set_metadata_recursive") {
+    g_recursive_state = state;
+    g_recursive_perms = parsed;
+
+    int rc = nftw(path.c_str(), MetadataWalker, 30,
+                  FTW_DEPTH | FTW_PHYS);
+
+    g_recursive_state = nullptr;
+
+    if (rc != 0) {
+      bad++;
+    }
+
+  } else {
+    bad += ApplyParsedPerms(
+        state, path.c_str(), &st, parsed);
+  }
+
+  if (bad != 0) {
+    return ErrorAbort(state, kSetMetadataFailure,
+                      "%s(): some metadata changes failed",
+                      name);
+  }
+
+  return StringValue("t");
+}
