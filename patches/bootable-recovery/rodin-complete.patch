+
+static std::string Rodin_Normalize_Slot_Suffix(std::string slot)
+{
+    if (slot == "a" || slot == "A" || slot == "_a")
+        return "_a";
+
+    if (slot == "b" || slot == "B" || slot == "_b")
+        return "_b";
+
+    return "";
+}
+
+
+static std::string Rodin_Get_Running_Slot()
+{
+    std::string slot =
+        android::base::GetProperty(
+            "ro.boot.slot_suffix", "");
+
+    if (slot.empty()) {
+        slot =
+            android::base::GetProperty(
+                "ro.boot.slot", "");
+    }
+
+    return Rodin_Normalize_Slot_Suffix(slot);
+}
+
+
+static std::string Rodin_Get_Installed_ROM_Slot(bool ab_ota_install)
+{
+    const std::string running =
+        Rodin_Get_Running_Slot();
+
+    /*
+     * Payload/update_engine A/B installs target the inactive slot.
+     * This is the same rule already used by the permanent
+     * OrangeFox installer below.
+     */
+    if (ab_ota_install) {
+        if (running == "_a")
+            return "_b";
+
+        if (running == "_b")
+            return "_a";
+
+        LOGERR(
+            "Auto Metadata: unable to determine A/B target slot.\n");
+
+        return "";
+    }
+
+    /*
+     * Traditional ROM installers normally operate on the slot
+     * currently selected by OrangeFox. Prefer that state.
+     */
+    std::string active =
+        Rodin_Normalize_Slot_Suffix(
+            PartitionManager.Get_Active_Slot_Suffix());
+
+    if (!active.empty())
+        return active;
+
+    /*
+     * Final fallback: the slot recovery itself booted from.
+     */
+    return running;
+}
