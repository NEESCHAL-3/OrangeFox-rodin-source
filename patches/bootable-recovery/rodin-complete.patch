+            ramdisk_path.find_last_of('/');
+
+        const std::string ramdisk_name =
+            (slash == std::string::npos)
+                ? ramdisk_path
+                : ramdisk_path.substr(slash + 1);
+
+        LOGINFO(
+            "Auto Metadata: inspecting ramdisk fragment %s\n",
+            ramdisk_name.c_str());
+
+        for (const char* candidate : candidates) {
+
+            result.clear();
+
+            const std::string exists_cmd =
+                "cd " + work +
+                " && " + magiskboot +
+                " cpio " + ramdisk_name +
+                " \"exists " +
+                std::string(candidate) +
+                "\"";
+
+            if (TWFunc::Exec_Cmd(
+                    exists_cmd,
+                    result) != 0)
+                continue;
+
+            /*
+             * Never allow an extraction from a previous candidate
+             * to be mistaken for this one.
+             */
+            unlink(
+                (work + "/fstab.mt6899").c_str());
+
+            result.clear();
+
+            const std::string extract_cmd =
+                "cd " + work +
+                " && " + magiskboot +
+                " cpio " + ramdisk_name +
+                " \"extract " +
+                std::string(candidate) +
+                " fstab.mt6899\"";
+
+            if (TWFunc::Exec_Cmd(
+                    extract_cmd,
+                    result) != 0)
+                continue;
+
+            std::ifstream in(
+                work + "/fstab.mt6899");
+
+            if (!in.is_open())
+                continue;
+
+            std::string line_text;
+
+            while (std::getline(in, line_text)) {
+
+                if (line_text.empty() ||
+                    line_text[0] == '#')
+                    continue;
+
+                std::istringstream line(line_text);
+
+                std::string device;
+                std::string mount_point;
+                std::string fs_type;
+
+                if (!(line >>
+                      device >>
+                      mount_point >>
+                      fs_type))
+                    continue;
+
+                if (mount_point != "/metadata")
+                    continue;
+
+                if (fs_type != "ext4" &&
+                    fs_type != "f2fs") {
+
+                    LOGERR(
+                        "Auto Metadata: ignoring unsupported "
+                        "Metadata FS '%s' in %s:%s\n",
+                        fs_type.c_str(),
+                        ramdisk_name.c_str(),
+                        candidate);
+
+                    continue;
+                }
+
+                required_fs = fs_type;
+
+                LOGINFO(
+                    "Auto Metadata: target slot %s requires "
+                    "Metadata %s; source=%s:%s\n",
+                    slot_suffix.c_str(),
+                    required_fs.c_str(),
+                    ramdisk_name.c_str(),
+                    candidate);
+
+                return true;
+            }
+        }
+    }
+
+    if (!found_ramdisk) {
+        LOGERR(
+            "Auto Metadata: vendor_boot contained no "
+            "vendor ramdisk fragments.\n");
+    } else {
+        LOGERR(
+            "Auto Metadata: no valid /metadata entry found "
+            "in target ROM first-stage fstab.\n");
+    }
+
+    return false;
+}
