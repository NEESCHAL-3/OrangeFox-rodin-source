+
+            result.clear();
+
+            const std::string extract_cmd =
+                "cd " + work +
+                " && " + magiskboot +
+                " cpio " + ramdisk_name +
+                " \"extract " +
+                std::string(candidate) +
+                " fstab.mt6899\"";
+
+            if (TWFunc::Exec_Cmd(
+                    extract_cmd,
+                    result) != 0)
+                continue;
+
+            std::ifstream in(
+                work + "/fstab.mt6899");
+
+            if (!in.is_open())
+                continue;
+
+            std::string line_text;
+
+            while (std::getline(in, line_text)) {
+
+                if (line_text.empty() ||
+                    line_text[0] == '#')
+                    continue;
+
+                std::istringstream line(line_text);
+
+                std::string device;
+                std::string mount_point;
+                std::string fs_type;
+
+                if (!(line >>
+                      device >>
+                      mount_point >>
+                      fs_type))
+                    continue;
+
+                if (mount_point != "/metadata")
+                    continue;
+
+                if (fs_type != "ext4" &&
+                    fs_type != "f2fs") {
+
+                    LOGERR(
+                        "Auto Metadata: ignoring unsupported "
+                        "Metadata FS '%s' in %s:%s\n",
+                        fs_type.c_str(),
+                        ramdisk_name.c_str(),
+                        candidate);
+
+                    continue;
+                }
+
+                required_fs = fs_type;
+
+                LOGINFO(
+                    "Auto Metadata: target slot %s requires "
+                    "Metadata %s; source=%s:%s\n",
+                    slot_suffix.c_str(),
+                    required_fs.c_str(),
+                    ramdisk_name.c_str(),
+                    candidate);
+
+                return true;
+            }
+        }
+    }
+
+    if (!found_ramdisk) {
+        LOGERR(
+            "Auto Metadata: vendor_boot contained no "
+            "vendor ramdisk fragments.\n");
+    } else {
+        LOGERR(
+            "Auto Metadata: no valid /metadata entry found "
+            "in target ROM first-stage fstab.\n");
+    }
+
+    return false;
+}
