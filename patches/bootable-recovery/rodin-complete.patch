+
+        const int old_total =
+                fdt_totalsize(old_fdt);
+
+        if (old_total <= 0 ||
+            static_cast<size_t>(
+                    old_total) >
+                    fdt_length) {
+
+                LOGERR(
+                        "Auto-DFE DTB: invalid FDT size.\n");
+                return RodinDtbPatchResult::Error;
+        }
+
+
+        /*
+         * Make absolutely sure this is the rodin-compatible DTB.
+         */
+        const int rodin_node =
+                fdt_path_offset(
+                        old_fdt,
+                        kRodinUsbNode);
+
+        if (rodin_node < 0 ||
+            !RodinCompatibleIsExpected(
+                    old_fdt,
+                    rodin_node)) {
+
+                LOGERR(
+                        "Auto-DFE DTB: rodin-compatible DTB not found.\n");
+                return RodinDtbPatchResult::Error;
+        }
+
+
+        /*
+         * Grow with plenty of slack.
+         */
+        const size_t capacity =
+                static_cast<size_t>(
+                        old_total) +
+                dfe_fstab.size() +
+                32768;
+
+        if (capacity >
+            32ULL * 1024ULL * 1024ULL) {
+
+                LOGERR(
+                        "Auto-DFE DTB: expanded FDT too large.\n");
+                return RodinDtbPatchResult::Error;
+        }
+
+        std::vector<uint8_t> expanded(
+                capacity);
+
+        int rc =
+                fdt_open_into(
+                        old_fdt,
+                        expanded.data(),
+                        static_cast<int>(
+                                expanded.size()));
+
+        if (rc != 0) {
+                LOGERR(
+                        "Auto-DFE DTB: fdt_open_into: %s\n",
+                        fdt_strerror(rc));
+                return RodinDtbPatchResult::Error;
+        }
+
+
+        int dfe_node =
+                fdt_path_offset(
+                        expanded.data(),
+                        "/fox_dfe");
+
+        if (dfe_node ==
+            -FDT_ERR_NOTFOUND) {
+
+                dfe_node =
+                        fdt_add_subnode(
+                                expanded.data(),
+                                0,
+                                "fox_dfe");
+        }
+
+        if (dfe_node < 0) {
+                LOGERR(
+                        "Auto-DFE DTB: create /fox_dfe: %s\n",
+                        fdt_strerror(dfe_node));
+                return RodinDtbPatchResult::Error;
+        }
+
+
+        rc =
+                fdt_setprop(
+                        expanded.data(),
+                        dfe_node,
+                        "metadata",
+                        dfe_fstab.data(),
+                        static_cast<int>(
+                                dfe_fstab.size()));
+
+        if (rc != 0) {
+                LOGERR(
+                        "Auto-DFE DTB: set metadata property: %s\n",
+                        fdt_strerror(rc));
+                return RodinDtbPatchResult::Error;
+        }
+
+
+        rc =
+                fdt_pack(
+                        expanded.data());
+
+        if (rc != 0) {
+                LOGERR(
+                        "Auto-DFE DTB: fdt_pack: %s\n",
+                        fdt_strerror(rc));
+                return RodinDtbPatchResult::Error;
+        }
+
+
+        const int packed_size =
+                fdt_totalsize(
+                        expanded.data());
+
+        if (packed_size <= 0) {
+                LOGERR(
+                        "Auto-DFE DTB: packed FDT size invalid.\n");
+                return RodinDtbPatchResult::Error;
+        }
+
+
+        /*
+         * Verify exact carrier bytes.
+         */
+        int verify_length = 0;
+
+        const void* verify =
+                fdt_getprop(
+                        expanded.data(),
+                        dfe_node,
+                        "metadata",
+                        &verify_length);
+
+        if (verify == nullptr ||
+            verify_length !=
+                    static_cast<int>(
+                            dfe_fstab.size()) ||
+            memcmp(
+                    verify,
+                    dfe_fstab.data(),
+                    dfe_fstab.size()) != 0) {
+
+                LOGERR(
+                        "Auto-DFE DTB: carrier verification failed.\n");
+                return RodinDtbPatchResult::Error;
+        }
+
+
+        std::vector<uint8_t> output_blob;
+
+        if (!mediatek_wrapper) {
+
+                output_blob.assign(
+                        expanded.begin(),
+                        expanded.begin() +
+                                packed_size);
+        }
+
+        else {
+
+                const size_t old_payload_end =
+                        fdt_offset +
+                        fdt_length;
+
+                const size_t suffix_size =
+                        blob.size() -
+                        old_payload_end;
+
+                const size_t new_total =
+                        fdt_offset +
+                        static_cast<size_t>(
+                                packed_size) +
+                        suffix_size;
+
+                if (new_total >
+                    0xffffffffULL) {
+
+                        LOGERR(
+                                "Auto-DFE DTB: container exceeds 32-bit size.\n");
+                        return RodinDtbPatchResult::Error;
+                }
+
+
+                output_blob.resize(
+                        new_total);
+
+
+                /*
+                 * Preserve MediaTek header.
+                 */
+                memcpy(
+                        output_blob.data(),
+                        blob.data(),
+                        fdt_offset);
+
+
+                /*
+                 * New FDT.
+                 */
+                memcpy(
+                        output_blob.data() +
+                                fdt_offset,
+                        expanded.data(),
+                        static_cast<size_t>(
+                                packed_size));
+
+
+                /*
+                 * Preserve suffix if the wrapper has one.
+                 */
+                if (suffix_size != 0) {
+
+                        memcpy(
+                                output_blob.data() +
+                                        fdt_offset +
+                                        packed_size,
+                                blob.data() +
+                                        old_payload_end,
+                                suffix_size);
+                }
+
+
+                /*
+                 * Update MediaTek container sizes.
+                 */
+                write_be32(
+                        output_blob.data() + 4,
+                        static_cast<uint32_t>(
+                                new_total));
+
+                write_be32(
+                        output_blob.data() + 32,
+                        static_cast<uint32_t>(
+                                packed_size));
+
+                write_be32(
+                        output_blob.data() + 36,
+                        static_cast<uint32_t>(
+                                fdt_offset));
+        }
+
+
+        void* final_fdt =
+                output_blob.data() +
+                (mediatek_wrapper ?
+                        fdt_offset :
+                        0);
+
+        if (fdt_check_header(
+                    final_fdt) != 0) {
+
+                LOGERR(
+                        "Auto-DFE DTB: final FDT validation failed.\n");
+                return RodinDtbPatchResult::Error;
+        }
+
+
+        std::ofstream output(
+                path,
+                std::ios::binary |
+                std::ios::trunc);
+
+        if (!output ||
+            !output.write(
+                    reinterpret_cast<
+                            const char*>(
+                                    output_blob.data()),
+                    static_cast<
+                            std::streamsize>(
+                                    output_blob.size()))) {
+
+                LOGERR(
+                        "Auto-DFE DTB: failed writing %s\n",
+                        path.c_str());
+                return RodinDtbPatchResult::Error;
+        }
+
+
+        LOGINFO(
+                "Auto-DFE DTB: persistent carrier embedded "
+                "(%zu bytes)\n",
+                dfe_fstab.size());
+
+        return RodinDtbPatchResult::Success;
+}
+
+
+RodinDtbPatchResult RodinPatchDtbDirectory(
+	const std::string& directory) {
+
+	DIR* dir =
+		opendir(directory.c_str());
+
+	if (!dir)
+		return RodinDtbPatchResult::NotFound;
+
+	RodinDtbPatchResult final_result =
+		RodinDtbPatchResult::NotFound;
+
+	while (dirent* entry = readdir(dir)) {
+		if (!std::strcmp(entry->d_name, ".") ||
+		    !std::strcmp(entry->d_name, "..")) {
+			continue;
+		}
+
+		std::string path = directory;
+
+		if (!path.empty() &&
+		    path.back() != '/') {
+			path += '/';
+		}
+
+		path += entry->d_name;
+
+		struct stat st {};
+
+		if (lstat(path.c_str(), &st) != 0)
+			continue;
+
+		RodinDtbPatchResult result =
+			RodinDtbPatchResult::NotFound;
+
+		if (S_ISDIR(st.st_mode)) {
+			result =
+				RodinPatchDtbDirectory(path);
+		}
+		else if (S_ISREG(st.st_mode)) {
+			result =
+				RodinPatchDtbFile(path);
+		}
+
+		if (result == RodinDtbPatchResult::Success ||
+		    result == RodinDtbPatchResult::Error) {
+			final_result = result;
+			break;
+		}
+	}
+
+	closedir(dir);
+	return final_result;
+}
+
+bool PatchRodinUsbOffloadDtb(
+	const std::string& directory) {
+
+	const RodinDtbPatchResult result =
+		RodinPatchDtbDirectory(directory);
+
+	if (result == RodinDtbPatchResult::Success)
+		return true;
+
+	if (result == RodinDtbPatchResult::NotFound) {
+		LOGERR(
+			"Rodin OTG DTB patch: compatible xHCI DTB was not found in %s\n",
+			directory.c_str());
+	}
+
+	return false;
+}
