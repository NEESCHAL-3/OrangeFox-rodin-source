+
+// -------------------------------------------------------------------------
+// Legacy Edify set_perm()/set_perm_recursive() compatibility.
+// These were used by older Android recovery ZIPs before set_metadata().
+// -------------------------------------------------------------------------
+
+struct LegacySetPermRecursiveContext {
+  uid_t uid;
+  gid_t gid;
+  mode_t dmode;
+  mode_t fmode;
+  int bad;
+};
+
+static LegacySetPermRecursiveContext g_legacy_set_perm_ctx;
+
+static int LegacySetPermRecursiveCallback(const char* path,
+                                          const struct stat* st,
+                                          int /*typeflag*/,
+                                          struct FTW* /*ftwbuf*/) {
+  if (st == nullptr) {
+    ++g_legacy_set_perm_ctx.bad;
+    return 0;
+  }
+
+  if (lchown(path, g_legacy_set_perm_ctx.uid,
+             g_legacy_set_perm_ctx.gid) < 0) {
+    fprintf(stderr, "set_perm_recursive: lchown(%s) failed: %s\n",
+            path, strerror(errno));
+    ++g_legacy_set_perm_ctx.bad;
+  }
+
+  // chmod() follows symlinks, so never apply it to a symlink.
+  if (!S_ISLNK(st->st_mode)) {
+    mode_t mode = S_ISDIR(st->st_mode)
+                      ? g_legacy_set_perm_ctx.dmode
+                      : g_legacy_set_perm_ctx.fmode;
+
+    if (chmod(path, mode) < 0) {
+      fprintf(stderr, "set_perm_recursive: chmod(%s, %o) failed: %s\n",
+              path, static_cast<unsigned>(mode), strerror(errno));
+      ++g_legacy_set_perm_ctx.bad;
+    }
+  }
+
+  return 0;
+}
+
+static Value* SetPermFn(
+    const char* name, State* state,
+    const std::vector<std::unique_ptr<Expr>>& argv) {
+  const size_t argc = argv.size();
+  const bool recursive =
+      strcmp(name, "set_perm_recursive") == 0;
+
+  const size_t min_args = recursive ? 5 : 4;
+
+  if (argc < min_args) {
+    return ErrorAbort(state, kArgsParsingFailure,
+                      "%s() expects %zu+ args, got %zu",
+                      name, min_args, argc);
+  }
+
+  std::vector<std::string> args;
+  if (!ReadArgs(state, argv, &args)) {
+    return ErrorAbort(state, kArgsParsingFailure,
+                      "%s() failed to parse arguments",
+                      name);
+  }
+
+  auto parse_number =
+      [&](const std::string& value,
+          const char* what,
+          unsigned long* output) -> bool {
+        errno = 0;
+        char* end = nullptr;
+
+        unsigned long result =
+            strtoul(value.c_str(), &end, 0);
+
+        if (errno != 0 ||
+            end == value.c_str() ||
+            *end != '\0') {
+          fprintf(stderr,
+                  "%s: invalid %s \"%s\"\n",
+                  name, what, value.c_str());
+          return false;
+        }
+
+        *output = result;
+        return true;
+      };
+
+  unsigned long uid_value;
+  unsigned long gid_value;
+
+  if (!parse_number(args[0], "uid", &uid_value) ||
+      !parse_number(args[1], "gid", &gid_value)) {
+    return ErrorAbort(state, kArgsParsingFailure,
+                      "%s(): invalid uid/gid", name);
+  }
+
+  const uid_t uid = static_cast<uid_t>(uid_value);
+  const gid_t gid = static_cast<gid_t>(gid_value);
+
+  int bad = 0;
+
+  if (recursive) {
+    unsigned long dmode_value;
+    unsigned long fmode_value;
+
+    if (!parse_number(args[2], "dirmode", &dmode_value) ||
+        !parse_number(args[3], "filemode", &fmode_value)) {
+      return ErrorAbort(state, kArgsParsingFailure,
+                        "%s(): invalid recursive mode", name);
+    }
+
+    g_legacy_set_perm_ctx.uid = uid;
+    g_legacy_set_perm_ctx.gid = gid;
+    g_legacy_set_perm_ctx.dmode =
+        static_cast<mode_t>(dmode_value);
+    g_legacy_set_perm_ctx.fmode =
+        static_cast<mode_t>(fmode_value);
+    g_legacy_set_perm_ctx.bad = 0;
+
+    for (size_t i = 4; i < argc; ++i) {
+      struct stat st;
+
+      if (lstat(args[i].c_str(), &st) < 0) {
+        fprintf(stderr,
+                "%s: lstat(%s) failed: %s\n",
+                name, args[i].c_str(), strerror(errno));
+        ++g_legacy_set_perm_ctx.bad;
+        continue;
+      }
+
+      if (nftw(args[i].c_str(),
+               LegacySetPermRecursiveCallback,
+               30,
+               FTW_DEPTH | FTW_PHYS) < 0) {
+        fprintf(stderr,
+                "%s: nftw(%s) failed: %s\n",
+                name, args[i].c_str(), strerror(errno));
+        ++g_legacy_set_perm_ctx.bad;
+      }
+    }
+
+    bad = g_legacy_set_perm_ctx.bad;
+
+  } else {
+    unsigned long mode_value;
+
+    if (!parse_number(args[2], "mode", &mode_value)) {
+      return ErrorAbort(state, kArgsParsingFailure,
+                        "%s(): invalid mode", name);
+    }
+
+    const mode_t mode =
+        static_cast<mode_t>(mode_value);
+
+    for (size_t i = 3; i < argc; ++i) {
+      const char* path = args[i].c_str();
+
+      struct stat st;
+      if (lstat(path, &st) < 0) {
+        fprintf(stderr,
+                "%s: lstat(%s) failed: %s\n",
+                name, path, strerror(errno));
+        ++bad;
+        continue;
+      }
+
+      if (lchown(path, uid, gid) < 0) {
+        fprintf(stderr,
+                "%s: lchown(%s, %u, %u) failed: %s\n",
+                name, path,
+                static_cast<unsigned>(uid),
+                static_cast<unsigned>(gid),
+                strerror(errno));
+        ++bad;
+      }
+
+      if (!S_ISLNK(st.st_mode) &&
+          chmod(path, mode) < 0) {
+        fprintf(stderr,
+                "%s: chmod(%s, %o) failed: %s\n",
+                name, path,
+                static_cast<unsigned>(mode),
+                strerror(errno));
+        ++bad;
+      }
+    }
+  }
+
+  if (bad != 0) {
+    return ErrorAbort(state, kSetMetadataFailure,
+                      "%s: some permission changes failed",
+                      name);
+  }
+
+  return StringValue("");
+}
+
+void RegisterLegacyCompatibilityFunctions() {
+  RegisterFunction("delete", DeleteFn);
+  RegisterFunction("delete_recursive", DeleteFn);
+  RegisterFunction("package_extract_dir", PackageExtractDirFn);
+  RegisterFunction("symlink", SymlinkFn);
+  RegisterFunction("set_perm", SetPermFn);
+  RegisterFunction("set_perm_recursive", SetPermFn);
+  RegisterFunction("set_metadata", SetMetadataFn);
+  RegisterFunction("set_metadata_recursive", SetMetadataFn);
+}
