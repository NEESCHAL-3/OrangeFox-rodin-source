+static bool Rodin_Auto_Metadata_FS(bool ab_ota_install)
+{
+    gui_print("\nAuto Metadata: checking newly installed ROM...\n");
+
+    const std::string target_slot =
+        Rodin_Get_Installed_ROM_Slot(
+            ab_ota_install);
+
+    if (target_slot.empty()) {
+        LOGERR(
+            "Auto Metadata: target ROM slot unknown.\n");
+
+        gui_print_color(
+            "error",
+            "Auto Metadata: unable to determine target ROM slot.\n");
+
+        return false;
+    }
+
+    std::string required_fs;
+
+    if (!Rodin_Read_Target_Metadata_FS(
+            target_slot,
+            required_fs)) {
+
+        gui_print_color(
+            "error",
+            "Auto Metadata: unable to detect ROM Metadata filesystem.\n");
+
+        return false;
+    }
+
+    TWPartition* metadata =
+        PartitionManager.Find_Partition_By_Path(
+            "/metadata");
+
+    if (!metadata) {
+        LOGERR(
+            "Auto Metadata: /metadata partition not found.\n");
+
+        gui_print_color(
+            "error",
+            "Auto Metadata: Metadata partition not found.\n");
+
+        return false;
+    }
+
+    /*
+     * Probe the physical filesystem now.
+     * Do not trust cached recovery-fstab state.
+     */
+    metadata->Check_FS_Type();
+
+    const std::string current_fs =
+        metadata->Current_File_System;
+
+    gui_print(
+        "Auto Metadata: target slot %s\n",
+        target_slot.c_str());
+
+    gui_print(
+        "Auto Metadata: ROM requires %s\n",
+        required_fs.c_str());
+
+    gui_print(
+        "Auto Metadata: current filesystem %s\n",
+        current_fs.empty()
+            ? "unknown"
+            : current_fs.c_str());
+
+    /*
+     * Never format Metadata unnecessarily.
+     */
+    if (current_fs == required_fs) {
+        gui_print_color(
+            "green",
+            "Auto Metadata: filesystem already matches.\n");
+
+        return true;
+    }
+
+    /*
+     * Metadata conversion is intentionally the final ROM preparation
+     * step. It must be fully unmounted before mkfs touches it.
+     */
+    PartitionManager.UnMount_By_Path(
+        "/metadata",
+        false);
+
+    sync();
+
+    gui_print(
+        "Auto Metadata: converting Metadata %s -> %s...\n",
+        current_fs.empty()
+            ? "unknown"
+            : current_fs.c_str(),
+        required_fs.c_str());
+
+    /*
+     * Uses the generic filesystem conversion path fixed in partition.cpp:
+     *
+     * - fresh on-disk FS probe
+     * - rm-rf forbidden during conversion
+     * - real target formatter
+     * - post-format filesystem verification
+     */
+    if (!metadata->Wipe(required_fs)) {
+        LOGERR(
+            "Auto Metadata: format to %s failed.\n",
+            required_fs.c_str());
+
+        gui_print_color(
+            "error",
+            "Auto Metadata: Metadata filesystem conversion FAILED.\n");
+
+        return false;
+    }
+
+    sync();
+
+    /*
+     * Independent second verification here as well.
+     */
+    metadata->Check_FS_Type();
+
+    if (metadata->Current_File_System !=
+        required_fs) {
+
+        LOGERR(
+            "Auto Metadata: final verification failed: "
+            "required=%s detected=%s\n",
+            required_fs.c_str(),
+            metadata->Current_File_System.c_str());
+
+        gui_print_color(
+            "error",
+            "Auto Metadata: final filesystem verification FAILED.\n");
+
+        return false;
+    }
+
+    gui_print_color(
+        "green",
+        "Auto Metadata: Metadata filesystem verified: %s\n",
+        required_fs.c_str());
+
+    gui_print(
+        "Auto Metadata: ROM preparation complete.\n");
+
+    return true;
+}
