+static bool Rodin_Read_Target_Metadata_FS(
+    const std::string& slot_suffix,
+    std::string& required_fs)
+{
+    if (slot_suffix != "_a" &&
+        slot_suffix != "_b") {
+
+        LOGERR(
+            "Auto Metadata: invalid target slot '%s'.\n",
+            slot_suffix.c_str());
+
+        return false;
+    }
+
+    const std::string work =
+        "/tmp/rodin_auto_metadata";
+
+    const std::string vendor_boot =
+        "/dev/block/by-name/vendor_boot" +
+        slot_suffix;
+
+    const std::string magiskboot =
+        "/sbin/magiskboot";
+
+    std::string result;
+
+    if (!TWFunc::Path_Exists(vendor_boot)) {
+        LOGERR(
+            "Auto Metadata: target vendor_boot missing: %s\n",
+            vendor_boot.c_str());
+        return false;
+    }
+
+    if (!TWFunc::Path_Exists(magiskboot)) {
+        LOGERR(
+            "Auto Metadata: magiskboot missing.\n");
+        return false;
+    }
+
+    /*
+     * Start from a completely clean work directory.
+     */
+    TWFunc::Exec_Cmd(
+        "rm -rf " + work +
+        " && mkdir -p " + work,
+        result);
+
+    result.clear();
+
+    /*
+     * Copy the final vendor_boot of the newly installed ROM.
+     */
+    if (TWFunc::Exec_Cmd(
+            "dd if=" + vendor_boot +
+            " of=" + work +
+            "/vendor_boot.img bs=4M",
+            result) != 0) {
+
+        LOGERR(
+            "Auto Metadata: failed to read target vendor_boot.\n");
+        return false;
+    }
+
+    result.clear();
+
+    /*
+     * Let magiskboot understand the vendor_boot version/layout.
+     *
+     * We intentionally do NOT assume:
+     *   vendor_ramdisk/ramdisk.cpio
+     *   vendor_ramdisk_platform.cpio
+     *   vendor_ramdisk_.cpio
+     *   or any other fragment name.
+     */
+    if (TWFunc::Exec_Cmd(
+            "cd " + work +
+            " && " + magiskboot +
+            " unpack vendor_boot.img",
+            result) != 0) {
+
+        LOGERR(
+            "Auto Metadata: failed to unpack target vendor_boot.\n");
+        return false;
+    }
+
