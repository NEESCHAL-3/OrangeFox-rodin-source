+     * Let magiskboot understand the vendor_boot version/layout.
+     *
+     * We intentionally do NOT assume:
+     *   vendor_ramdisk/ramdisk.cpio
+     *   vendor_ramdisk_platform.cpio
+     *   vendor_ramdisk_.cpio
+     *   or any other fragment name.
+     */
+    if (TWFunc::Exec_Cmd(
+            "cd " + work +
+            " && " + magiskboot +
+            " unpack vendor_boot.img",
+            result) != 0) {
