+#ifdef RODIN_RUNTIME_DTB_FIX
+static bool Rodin_Recompress_V4_Platform_To_Zstd(
+        const std::string& unpack_dir) {
+
+        std::string base = unpack_dir;
+        if (!base.empty() && base.back() != '/')
+                base += "/";
+
+        const std::string table_path =
+                base + "ramdisk_table";
+
+        struct stat table_stat {};
+
+        if (stat(table_path.c_str(), &table_stat) != 0 ||
+            table_stat.st_size < 108) {
+                LOGINFO(
+                        "Rodin vendor_boot space fix: no usable v4 ramdisk table; "
+                        "leaving PLATFORM unchanged.\n");
+                return true;
+        }
+
+        std::vector<uint8_t> table(
+                static_cast<size_t>(table_stat.st_size));
+
+        {
+                std::ifstream in(
+                        table_path,
+                        std::ios::binary);
+
+                if (!in)
+                        return false;
+
+                in.read(
+                        reinterpret_cast<char*>(table.data()),
+                        table.size());
+
+                if (!in)
+                        return false;
+        }
+
+        auto le32 = [](const uint8_t* p) -> uint32_t {
+                return static_cast<uint32_t>(p[0]) |
+                       (static_cast<uint32_t>(p[1]) << 8) |
+                       (static_cast<uint32_t>(p[2]) << 16) |
+                       (static_cast<uint32_t>(p[3]) << 24);
+        };
+
+        /*
+         * Android vendor_boot v4 vendor_ramdisk_table_entry:
+         *
+         *   +0   ramdisk_size
+         *   +4   ramdisk_offset
+         *   +8   ramdisk_type
+         *   +12  ramdisk_name[32]
+         *   +44  board_id[16]
+         *
+         * Standard entry size = 108 bytes.
+         *
+         * TYPE=1 is PLATFORM.
+         */
+        constexpr size_t entry_size = 108;
+
+        bool found_platform = false;
+
+        for (size_t off = 0;
+             off + entry_size <= table.size();
+             off += entry_size) {
+
+                const uint8_t* entry =
+                        table.data() + off;
+
+                const uint32_t ramdisk_type =
+                        le32(entry + 8);
+
+                if (ramdisk_type != 1)
+                        continue;
+
+                found_platform = true;
+
+                char name_buffer[33] {};
+                memcpy(
+                        name_buffer,
+                        entry + 12,
+                        32);
+
+                const std::string ramdisk_name(
+                        name_buffer);
+
+                std::vector<std::string> candidates;
+
+                /*
+                 * Current magiskboot v4 layout.
+                 * Empty PLATFORM name becomes vendor_ramdisk_.cpio.
+                 */
+                candidates.push_back(
+                        base +
+                        "vendor_ramdisk_" +
+                        ramdisk_name +
+                        ".cpio");
+
+                /*
+                 * Older/nested magiskboot layouts.
+                 */
+                if (ramdisk_name.empty()) {
+                        candidates.push_back(
+                                base +
+                                "vendor_ramdisk/ramdisk.cpio");
+                        candidates.push_back(
+                                base +
+                                "vendor_ramdisk/platform.cpio");
+                } else {
+                        candidates.push_back(
+                                base +
+                                "vendor_ramdisk/" +
+                                ramdisk_name +
+                                ".cpio");
+                }
+
+                std::string platform_path;
+
+                for (const auto& candidate : candidates) {
+                        if (TWFunc::Path_Exists(candidate)) {
+                                platform_path = candidate;
+                                break;
+                        }
+                }
+
+                if (platform_path.empty()) {
+                        LOGERR(
+                                "Rodin vendor_boot space fix: "
+                                "TYPE=1 PLATFORM fragment file not found.\n");
+                        return false;
+                }
+
+                /*
+                 * Already Zstd: nothing to do.
+                 */
+                const std::string raw_cpio =
+                        base +
+                        "rodin-platform-raw.cpio";
+
+                const std::string layer_a =
+                        base +
+                        "rodin-platform-layer-a.bin";
+
+                const std::string layer_b =
+                        base +
+                        "rodin-platform-layer-b.bin";
+
+                const std::string zstd_tmp =
+                        base +
+                        "rodin-platform-zstd.tmp";
+
+                unlink(raw_cpio.c_str());
+                unlink(layer_a.c_str());
+                unlink(layer_b.c_str());
+                unlink(zstd_tmp.c_str());
+
+                /*
+                 * magiskboot may wrap an already-Zstd vendor ramdisk
+                 * fragment in the vendor_boot's legacy-LZ4 ramdisk
+                 * format during repack.
+                 *
+                 * Example seen on rodin after one successful reflash:
+                 *
+                 *   LZ4 -> Zstd -> raw newc CPIO
+                 *
+                 * Therefore never assume one decompression layer.
+                 * Unwrap until we reach the actual newc CPIO.
+                 */
+                std::string current_layer =
+                        platform_path;
+
+                bool reached_cpio = false;
+
+                for (int depth = 0;
+                     depth < 4;
+                     ++depth) {
+
+                        uint8_t layer_magic[6] {};
+
+                        {
+                                std::ifstream probe(
+                                        current_layer,
+                                        std::ios::binary);
+
+                                if (!probe)
+                                        return false;
+
+                                probe.read(
+                                        reinterpret_cast<char*>(
+                                                layer_magic),
+                                        sizeof(layer_magic));
+
+                                if (!probe)
+                                        return false;
+                        }
+
+                        const bool is_newc =
+                                memcmp(
+                                        layer_magic,
+                                        "070701",
+                                        6) == 0 ||
+                                memcmp(
+                                        layer_magic,
+                                        "070702",
+                                        6) == 0;
+
+                        if (is_newc) {
+                                if (current_layer !=
+                                    raw_cpio) {
+
+                                        if (TWFunc::copy_file(
+                                                    current_layer,
+                                                    raw_cpio,
+                                                    0644)) {
+
+                                                LOGERR(
+                                                        "Rodin vendor_boot space fix: "
+                                                        "failed to save raw PLATFORM CPIO.\n");
+
+                                                return false;
+                                        }
+                                }
+
+                                reached_cpio = true;
+                                break;
+                        }
+
+                        const std::string next_layer =
+                                (depth % 2 == 0)
+                                        ? layer_a
+                                        : layer_b;
+
+                        unlink(next_layer.c_str());
+
+                        const uint8_t zstd_magic[4] = {
+                                0x28, 0xB5, 0x2F, 0xFD
+                        };
+
+                        const bool is_zstd =
+                                memcmp(
+                                        layer_magic,
+                                        zstd_magic,
+                                        sizeof(zstd_magic)) == 0;
+
+                        if (is_zstd) {
+                                struct stat compressed_stat {};
+
+                                if (stat(
+                                            current_layer.c_str(),
+                                            &compressed_stat) != 0 ||
+                                    compressed_stat.st_size <= 0) {
+
+                                        LOGERR(
+                                                "Rodin vendor_boot space fix: "
+                                                "invalid nested Zstd PLATFORM.\n");
+                                        return false;
+                                }
+
+                                std::vector<uint8_t> compressed(
+                                        static_cast<size_t>(
+                                                compressed_stat.st_size));
+
+                                {
+                                        std::ifstream in(
+                                                current_layer,
+                                                std::ios::binary);
+
+                                        if (!in)
+                                                return false;
+
+                                        in.read(
+                                                reinterpret_cast<char*>(
+                                                        compressed.data()),
+                                                compressed.size());
+
+                                        if (!in)
+                                                return false;
+                                }
+
+                                const unsigned long long decoded_size =
+                                        ZSTD_getFrameContentSize(
+                                                compressed.data(),
+                                                compressed.size());
+
+                                if (decoded_size ==
+                                            ZSTD_CONTENTSIZE_ERROR ||
+                                    decoded_size ==
+                                            ZSTD_CONTENTSIZE_UNKNOWN ||
+                                    decoded_size == 0 ||
+                                    decoded_size > SIZE_MAX) {
+
+                                        LOGERR(
+                                                "Rodin vendor_boot space fix: "
+                                                "invalid nested Zstd frame size.\n");
+                                        return false;
+                                }
+
+                                std::vector<uint8_t> decoded(
+                                        static_cast<size_t>(
+                                                decoded_size));
+
+                                const size_t actual =
+                                        ZSTD_decompress(
+                                                decoded.data(),
+                                                decoded.size(),
+                                                compressed.data(),
+                                                compressed.size());
+
+                                if (ZSTD_isError(actual) ||
+                                    actual != decoded.size()) {
+
+                                        LOGERR(
+                                                "Rodin vendor_boot space fix: "
+                                                "nested Zstd decompression failed: %s\n",
+                                                ZSTD_isError(actual)
+                                                        ? ZSTD_getErrorName(actual)
+                                                        : "decoded size mismatch");
+                                        return false;
+                                }
+
+                                {
+                                        std::ofstream out(
+                                                next_layer,
+                                                std::ios::binary |
+                                                std::ios::trunc);
+
+                                        if (!out)
+                                                return false;
+
+                                        out.write(
+                                                reinterpret_cast<const char*>(
+                                                        decoded.data()),
+                                                decoded.size());
+
+                                        if (!out)
+                                                return false;
+                                }
+
+                                chmod(next_layer.c_str(), 0644);
+
+                        } else {
+                                std::string result;
+
+                                const std::string command =
+                                        TWFunc::Get_MagiskBoot() +
+                                        " decompress " +
+                                        current_layer +
+                                        " " +
+                                        next_layer;
+
+                                if (TWFunc::Exec_Cmd(
+                                            command,
+                                            result) != 0) {
+
+                                        LOGERR(
+                                                "Rodin vendor_boot space fix: "
+                                                "failed to unwrap PLATFORM "
+                                                "compression layer %d.\n",
+                                                depth + 1);
+
+                                        return false;
+                                }
+                        }
+
+                        struct stat layer_stat {};
+
+                        if (stat(
+                                    next_layer.c_str(),
+                                    &layer_stat) != 0 ||
+                            layer_stat.st_size <= 0) {
+
+                                LOGERR(
+                                        "Rodin vendor_boot space fix: "
+                                        "invalid PLATFORM layer %d.\n",
+                                        depth + 1);
+
+                                return false;
+                        }
+
+                        LOGINFO(
+                                "Rodin vendor_boot space fix: "
+                                "unwrapped PLATFORM compression "
+                                "layer %d (%lld bytes).\n",
+                                depth + 1,
+                                static_cast<long long>(
+                                        layer_stat.st_size));
+
+                        current_layer =
+                                next_layer;
+                }
+
+                if (!reached_cpio) {
+                        LOGERR(
+                                "Rodin vendor_boot space fix: "
+                                "unable to reach raw PLATFORM CPIO "
+                                "after nested decompression.\n");
+
+                        return false;
+                }
+
+                unlink(layer_a.c_str());
+                unlink(layer_b.c_str());
+
+                struct stat raw_stat {};
+                struct stat old_stat {};
+
+                if (stat(raw_cpio.c_str(), &raw_stat) != 0 ||
+                    raw_stat.st_size <= 0 ||
+                    stat(platform_path.c_str(), &old_stat) != 0 ||
+                    old_stat.st_size <= 0) {
+
+                        LOGERR(
+                                "Rodin vendor_boot space fix: "
+                                "invalid PLATFORM size.\n");
+                        return false;
+                }
+
+                /*
+                 * Verify that magiskboot actually produced a CPIO.
+                 */
+                {
+                        uint8_t cpio_magic[6] {};
+
+                        std::ifstream check(
+                                raw_cpio,
+                                std::ios::binary);
+
+                        if (!check)
+                                return false;
+
+                        check.read(
+                                reinterpret_cast<char*>(cpio_magic),
+                                sizeof(cpio_magic));
+
+                        if (memcmp(cpio_magic, "070701", 6) != 0 &&
+                            memcmp(cpio_magic, "070702", 6) != 0) {
+
+                                LOGERR(
+                                        "Rodin vendor_boot space fix: "
+                                        "decompressed PLATFORM is not a valid newc CPIO.\n");
+                                return false;
+                        }
+                }
+
+                /*
+                 * A vendor_boot v4 PLATFORM fragment is loaded during
+                 * recovery boot as well.
+                 *
+                 * Some rodin OEM vendor_boot images incorrectly carry a
+                 * complete stock-recovery userspace inside TYPE=PLATFORM.
+                 * Injecting OrangeFox TYPE=RECOVERY on top of that leaves
+                 * two recovery environments in the initramfs.
+                 *
+                 * Preserve the TARGET ROM's platform hardware content,
+                 * modules, properties and first-stage files, but remove
+                 * only the stock-recovery payload which belongs to the
+                 * recovery fragment.
+                 *
+                 * Probe for system/bin/recovery so normal PLATFORM
+                 * ramdisks are left completely untouched.
+                 */
+                const std::string rodin_stock_recovery_probe =
+                        TWFunc::Get_MagiskBoot() +
+                        " cpio " +
+                        raw_cpio +
+                        " \"exists system/bin/recovery\"";
+
+                std::string rodin_stock_recovery_probe_output;
+
+                const int rodin_stock_recovery_probe_result =
+                        TWFunc::Exec_Cmd(
+                                rodin_stock_recovery_probe,
+                                rodin_stock_recovery_probe_output,
+                                true);
+
+                /*
+                 * magiskboot cpio "exists" returns:
+                 *   0 = entry exists
+                 *   1 = entry does not exist
+                 *
+                 * A return value of 1 is expected during the final
+                 * normalization pass after sanitization has already run.
+                 * Keep the probe output internal instead of showing a
+                 * false red error in the recovery UI.
+                 */
+                if (rodin_stock_recovery_probe_result == 0) {
+
+                        LOGINFO(
+                                "Rodin auto-reflash: TARGET PLATFORM contains "
+                                "embedded stock-recovery userspace; sanitizing it.\n");
+
+                        const std::string sanitize_command =
+                                TWFunc::Get_MagiskBoot() +
+                                " cpio " +
+                                raw_cpio +
+
+                                " \"rm miui.factoryreset.rc\"" +
+                                " \"rm -r res\"" +
+
+                                " \"rm system/bin/adbd\"" +
+                                " \"rm system/bin/fastbootd\"" +
+                                " \"rm system/bin/logcat\"" +
+                                " \"rm system/bin/logd\"" +
+                                " \"rm system/bin/recovery\"" +
+                                " \"rm system/bin/servicemanager\"" +
+                                " \"rm system/bin/sh\"" +
+                                " \"rm system/bin/toolbox\"" +
+                                " \"rm system/bin/toybox\"" +
+                                " \"rm system/bin/update_engine_sideload\"" +
+
+                                " \"rm system/bin/hw/android.hardware.boot-service.mtk_recovery\"" +
+                                " \"rm system/bin/hw/android.hardware.health-service.example_recovery\"" +
+
+                                " \"rm system/etc/init/android.hardware.boot-service.mtk_recovery.rc\"" +
+                                " \"rm system/etc/init/android.hardware.health-service.example_recovery.rc\"" +
+                                " \"rm system/etc/init/recovery-persist.rc\"" +
+                                " \"rm system/etc/init/recovery-refresh.rc\"" +
+                                " \"rm system/etc/init/servicemanager.recovery.rc\"" +
+
+                                " \"rm system/etc/recovery.fstab\"" +
+                                " \"rm system/etc/security/otacerts.zip\"" +
+
+                                " \"rm system/etc/vintf/manifest/android.hardware.boot-service.mtk.xml\"" +
+                                " \"rm system/etc/vintf/manifest/android.hardware.health-service.example.xml\"" +
+
+                                " \"rm system/lib64/librecovery_ui.so\"";
+
+                        if (TWFunc::Exec_Cmd(
+                                    sanitize_command) != 0) {
+
+                                LOGERR(
+                                        "Rodin auto-reflash: failed to remove "
+                                        "TARGET stock-recovery payload.\n");
+                                return false;
+                        }
+
+                        /*
+                         * magiskboot cpio modified the archive in-place.
+                         * Refresh its size before reading it below.
+                         */
+                        if (stat(
+                                    raw_cpio.c_str(),
+                                    &raw_stat) != 0 ||
+                            raw_stat.st_size <= 0) {
+
+                                LOGERR(
+                                        "Rodin auto-reflash: sanitized "
+                                        "PLATFORM CPIO is invalid.\n");
+                                return false;
+                        }
+
+                        LOGINFO(
+                                "Rodin auto-reflash: TARGET stock-recovery "
+                                "payload removed; PLATFORM CPIO=%lld bytes. "
+                                "Modules and ROM platform content preserved.\n",
+                                static_cast<long long>(
+                                        raw_stat.st_size));
+                }
+
+                std::vector<uint8_t> raw_data(
+                        static_cast<size_t>(
+                                raw_stat.st_size));
+
+                {
+                        std::ifstream in(
+                                raw_cpio,
+                                std::ios::binary);
+
+                        if (!in)
+                                return false;
+
+                        in.read(
+                                reinterpret_cast<char*>(
+                                        raw_data.data()),
+                                raw_data.size());
+
+                        if (!in)
+                                return false;
+                }
+
+                const size_t bound =
+                        ZSTD_compressBound(
+                                raw_data.size());
+
+                if (bound == 0) {
+                        LOGERR(
+                                "Rodin vendor_boot space fix: "
+                                "invalid Zstd bound.\n");
+                        return false;
+                }
+
+                std::vector<uint8_t> compressed(
+                        bound);
+
+                const size_t compressed_size =
+                        ZSTD_compress(
+                                compressed.data(),
+                                compressed.size(),
+                                raw_data.data(),
+                                raw_data.size(),
+                                19);
+
+                if (ZSTD_isError(compressed_size)) {
+                        LOGERR(
+                                "Rodin vendor_boot space fix: "
+                                "Zstd compression failed: %s\n",
+                                ZSTD_getErrorName(
+                                        compressed_size));
+                        return false;
+                }
+
+                /*
+                 * Never make the vendor_boot larger.
+                 */
+                if (compressed_size >=
+                    static_cast<size_t>(
+                            old_stat.st_size)) {
+
+                        LOGINFO(
+                                "Rodin vendor_boot space fix: "
+                                "Zstd provides no size benefit "
+                                "(old=%lld new=%zu); preserving original PLATFORM.\n",
+                                static_cast<long long>(
+                                        old_stat.st_size),
+                                compressed_size);
+
+                        unlink(raw_cpio.c_str());
+                        continue;
+                }
+
+                compressed.resize(
+                        compressed_size);
+
+                {
+                        std::ofstream out(
+                                zstd_tmp,
+                                std::ios::binary |
+                                std::ios::trunc);
+
+                        if (!out)
+                                return false;
+
+                        out.write(
+                                reinterpret_cast<const char*>(
+                                        compressed.data()),
+                                compressed.size());
+
+                        if (!out)
+                                return false;
+                }
+
+                if (rename(
+                            zstd_tmp.c_str(),
+                            platform_path.c_str()) != 0) {
+
+                        LOGERR(
+                                "Rodin vendor_boot space fix: "
+                                "failed to install recompressed PLATFORM.\n");
+                        return false;
+                }
+
+                chmod(
+                        platform_path.c_str(),
+                        0644);
+
+                unlink(raw_cpio.c_str());
+
+                LOGINFO(
+                        "Rodin vendor_boot space fix: "
+                        "PLATFORM recompressed to Zstd "
+                        "(%lld -> %zu bytes, saved %lld bytes).\n",
+                        static_cast<long long>(
+                                old_stat.st_size),
+                        compressed_size,
+                        static_cast<long long>(
+                                old_stat.st_size -
+                                static_cast<off_t>(
+                                        compressed_size)));
+        }
+
+        if (!found_platform) {
+                LOGINFO(
+                        "Rodin vendor_boot space fix: "
+                        "no TYPE=1 PLATFORM entry found; leaving image unchanged.\n");
+        }
+
+        return true;
+}
+#endif
+
+
+static bool is_AB_for_repacker() {
+	std::string slot = android::base::GetProperty("ro.boot.slot_suffix", "");
+	if (slot.empty())
+		slot = android::base::GetProperty("ro.boot.slot", "");
+	return !slot.empty();
+}
+
+bool twrpRepacker::Repack_Image_And_Flash(const std::string& Target_Image, const struct Repack_Options_struct& Repack_Options, bool Flash_Both_Slots, bool Patch_Rodin_Usb_Dtb) {
+	if (!TWFunc::Path_Exists(TWFunc::Get_MagiskBoot())) {
+		LOGERR("Image repacking tool not present in this TWRP build!");
+		return false;
+	}
+
+	bool recompress = false;
+	bool is_vendor_boot = false;
+	bool is_vendor_boot_v4 = false;
+	std::string dest_partition = "/boot";
+	std::string ramdisk_cpio = "ramdisk.cpio";
+
+	#if defined(BOARD_MOVE_RECOVERY_RESOURCES_TO_VENDOR_BOOT) || defined(FOX_VENDOR_BOOT_RECOVERY)
+		dest_partition = "/vendor_boot";
+		is_vendor_boot = true;
+		if (DataManager::GetIntValue("tw_boot_header_version") > 3) {
+			is_vendor_boot_v4 = true;
+			ramdisk_cpio = "vendor_ramdisk_recovery.cpio";
+			if (!TWFunc::Path_Exists(ramdisk_cpio) && TWFunc::Path_Exists("vendor_ramdisk/recovery.cpio"))
+				ramdisk_cpio = "vendor_ramdisk/recovery.cpio";
+			LOGINFO("Vendor_boot with v4+ header\n");
+		} else {
+			LOGINFO("Vendor_boot with lower than v4 header\n");
+		}
+	#else
+		// we shouldn't reach here, because of the code in twrpRepacker::Flash_Current_Twrp(); but if we do, then handle it
+		if (PartitionManager.Find_Partition_By_Path("/recovery") && is_AB_for_repacker()) {
+			dest_partition = "/recovery";
+		}
+	#endif
+
+	if (is_vendor_boot || is_vendor_boot_v4) {
+		// placeholder for any specific vendor_boot stuff;
+		// in the meantime, stop the compiler's complaints about unused variables
+	}
+
+	DataManager::SetProgress(0);
+	PartitionManager.Update_System_Details();
+	TWPartition* part = PartitionManager.Find_Partition_By_Path(dest_partition);
+	if (part)
+		gui_msg(Msg("unpacking_image=Unpacking {1}...")(part->Get_Display_Name()));
+	else {
+		gui_msg(Msg(msg::kError, "unable_to_locate=Unable to locate {1}.")(dest_partition.c_str()));
+		return false;
+	}
+	if (!Backup_Image_For_Repack(part, REPACK_ORIG_DIR, Repack_Options.Backup_First, gui_lookup("repack", "Repack")))
+		return false;
+
+#ifdef RODIN_RUNTIME_DTB_FIX
+	if (Patch_Rodin_Usb_Dtb) {
+		LOGINFO("Applying rodin target-slot OTG DTB patch before vendor_boot repack.\n");
+
+		if (!PatchRodinUsbOffloadDtb(REPACK_ORIG_DIR)) {
+			LOGERR("Rodin OTG DTB patch failed; refusing to flash an unsafe auto-repacked vendor_boot.\n");
+			gui_print("Rodin OTG DTB patch failed. OrangeFox auto-reflash aborted.\n");
+			return false;
+		}
+	}
+#endif
+
+	DataManager::SetProgress(.25);
+	if (Repack_Options.Type == REPLACE_RAMDISK_UNPACKED ||
+	    Repack_Options.Type == REPLACE_RAMDISK_COMPRESSED) {
+		if (!Prepare_Empty_Folder(REPACK_NEW_DIR))
+			return false;
+
+		if (Repack_Options.Type == REPLACE_RAMDISK_COMPRESSED)
+			image_ramdisk_format = original_ramdisk_format;
+		else
+			image_ramdisk_format = "gzip";
+	} else {
+		gui_msg(Msg("unpacking_image=Unpacking {1}...")(Target_Image));
+		image_ramdisk_format = Unpack_Image(Target_Image, REPACK_NEW_DIR, true);
+	}
+	if (image_ramdisk_format.empty())
+		return false;
+	DataManager::SetProgress(.5);
+
+
+#ifdef RODIN_RUNTIME_DTB_FIX
+        if (is_vendor_boot_v4 && Patch_Rodin_Usb_Dtb) {
+                gui_print_color(
+                        "warning",
+                        "\n[ OrangeFox Auto-Reflash ]\n");
+                gui_print(
+                        "Preparing recovery for the newly installed ROM...\n"
+                        "Please wait. Do not reboot or power off the device.\n\n");
+                LOGINFO(
+                        "Rodin auto-reflash: starting OrangeFox vendor_boot reflash.\n");
+        }
+#endif
+	gui_msg(Msg("repacking_image=Repacking {1}...")(part->Get_Display_Name()));
+#if defined(OF_RECOVERY_AB_FULL_REFLASH_RAMDISK) && defined(OF_AB_DEVICE_WITH_RECOVERY_PARTITION)
+	gui_msg(Msg(msg::kHighlight, "lang_wait=Please wait ..."));
+#endif
+	std::string path = REPACK_NEW_DIR;
+	if (Repack_Options.Type == REPLACE_KERNEL) {
+		// When we replace the kernel, what we really do is copy the boot partition ramdisk into the new image's folder
+		if (TWFunc::copy_file(REPACK_ORIG_DIR + ramdisk_cpio, REPACK_NEW_DIR + ramdisk_cpio, 0644)) {
+			LOGERR("Failed to copy ramdisk\n");
+			return false;
+		}
+	} else if (Repack_Options.Type == REPLACE_RAMDISK_UNPACKED ||
+	           Repack_Options.Type == REPLACE_RAMDISK_COMPRESSED) {
+			if (TWFunc::copy_file(Target_Image, REPACK_ORIG_DIR + ramdisk_cpio, 0644)) {
+				LOGERR("Failed to copy ramdisk\n");
+				return false;
+			}
+			if (TWFunc::copy_file(Target_Image, REPACK_NEW_DIR + ramdisk_cpio, 0644)) {
+				LOGERR("Failed to copy ramdisk\n");
+				return false;
+			}
+		path = REPACK_ORIG_DIR;
+	} else if (Repack_Options.Type == REPLACE_RAMDISK) {
+		// Repack the ramdisk
+		if (TWFunc::copy_file(REPACK_NEW_DIR + ramdisk_cpio, REPACK_ORIG_DIR + ramdisk_cpio, 0644)) {
+			LOGERR("Failed to copy ramdisk\n");
+			return false;
+		}
+		path = REPACK_ORIG_DIR;
+	} else {
+		LOGERR("Invalid repacking options specified\n");
+		return false;
+	}
+
+#ifdef RODIN_RUNTIME_DTB_FIX
+        bool rodin_compacted_for_size = false;
+        constexpr long long kRodinVendorBootLimit = 67108864LL;
+#endif
+
+	if (Repack_Options.Disable_Verity)
+		LOGERR("Disabling verity is not implemented yet\n");
+	if (Repack_Options.Disable_Force_Encrypt)
+		LOGERR("Disabling force encrypt is not implemented yet\n");
+	std::string command =
+                "cd " + path + " && " +
+                TWFunc::Get_MagiskBoot() + " repack ";
+
+#ifdef RODIN_RUNTIME_DTB_FIX
+        /*
+         * Unpack_Image() uses magiskboot unpack -n.
+         *
+         * For rodin vendor_boot v4 compressed auto-reflash:
+         *   - PLATFORM is already normalized to one Zstd stream.
+         *   - OrangeFox recovery is already legacy-LZ4 compressed.
+         *
+         * Therefore MagiskBoot must preserve both prepared fragment
+         * formats instead of restoring OEM compression around them.
+         */
+        const bool rodin_preserve_vendor_ramdisk_compression =
+                is_vendor_boot_v4 &&
+                Repack_Options.Type == REPLACE_RAMDISK_COMPRESSED;
+
+        if (rodin_preserve_vendor_ramdisk_compression) {
+                command += "-n ";
+
+                LOGINFO(
+                        "Rodin auto-reflash: magiskboot repack -n; "
+                        "preserving prepared PLATFORM/recovery compression.\n");
+        }
+#endif
+	if (original_ramdisk_format != image_ramdisk_format) {
+		recompress = true;
+	}
+
+	command += path + "boot.img";
+
+	std::string orig_compressed_image(REPACK_ORIG_DIR);
+	orig_compressed_image += ramdisk_cpio;
+	std::string copy_compressed_image(REPACK_ORIG_DIR);
+	copy_compressed_image += "ramdisk-1.cpio";
+
+	if (recompress) {
+		std::string decompress_cmd = TWFunc::Get_MagiskBoot() + " decompress " + orig_compressed_image + " " + copy_compressed_image;
+		if (TWFunc::Exec_Cmd(decompress_cmd) != 0) {
+			gui_msg(Msg(msg::kError, "repack_error=Error repacking image."));
+			return false;
+		}
+		std::rename(copy_compressed_image.c_str(), orig_compressed_image.c_str());
+	}
+
+	if (TWFunc::Exec_Cmd(command) != 0) {
+		gui_msg(Msg(msg::kError, "repack_error=Error repacking image."));
+		return false;
+	}
+
+#ifdef RODIN_RUNTIME_DTB_FIX
+        if (is_vendor_boot_v4 && Patch_Rodin_Usb_Dtb) {
+                const std::string rodin_candidate =
+                        path + "new-boot.img";
+
+                struct stat initial_stat {};
+
+                if (stat(rodin_candidate.c_str(), &initial_stat) != 0 ||
+                    initial_stat.st_size <= 0) {
+                        LOGERR(
+                                "Rodin auto-reflash: cannot inspect initial "
+                                "vendor_boot candidate.\n");
+                        return false;
+                }
+
+                LOGINFO(
+                        "Rodin auto-reflash: initial candidate size=%lld bytes.\n",
+                        static_cast<long long>(initial_stat.st_size));
+
+                if (static_cast<long long>(initial_stat.st_size) >
+                    kRodinVendorBootLimit) {
+
+                        gui_print_color(
+                                "warning",
+                                "\n[ Optimizing vendor_boot ]\n");
+                        gui_print(
+                                "Preparing the target ROM for OrangeFox...\n"
+                                "Preserving ROM platform files and removing "
+                                "conflicting stock recovery files.\n"
+                                "Please wait...\n");
+
+                        LOGINFO(
+                                "Rodin auto-reflash: oversized candidate; "
+                                "compacting TARGET ROM PLATFORM only.\n");
+
+                        if (!Rodin_Recompress_V4_Platform_To_Zstd(path)) {
+                                LOGERR(
+                                        "Rodin auto-reflash: target PLATFORM "
+                                        "compaction failed.\n");
+                                gui_print_color(
+                                        "error",
+                                        "OrangeFox could not safely compact "
+                                        "the target vendor_boot.\n");
+                                return false;
+                        }
+
+                        rodin_compacted_for_size = true;
+
+                        unlink(rodin_candidate.c_str());
+
+                        if (TWFunc::Exec_Cmd(command) != 0) {
+                                gui_msg(
+                                        Msg(
+                                                msg::kError,
+                                                "repack_error=Error repacking image."));
+                                return false;
+                        }
+
+                        struct stat compact_stat {};
+
+                        if (stat(rodin_candidate.c_str(), &compact_stat) != 0 ||
+                            compact_stat.st_size <= 0) {
+                                LOGERR(
+                                        "Rodin auto-reflash: cannot inspect "
+                                        "compacted vendor_boot candidate.\n");
+                                return false;
+                        }
+
+                        LOGINFO(
+                                "Rodin auto-reflash: compacted candidate "
+                                "size=%lld bytes.\n",
+                                static_cast<long long>(compact_stat.st_size));
+
+                        if (static_cast<long long>(compact_stat.st_size) >
+                            kRodinVendorBootLimit) {
+                                LOGERR(
+                                        "Rodin auto-reflash: vendor_boot still "
+                                        "exceeds 64 MiB after target PLATFORM "
+                                        "compaction.\n");
+                                gui_print_color(
+                                        "error",
+                                        "OrangeFox recovery is too large for "
+                                        "this ROM vendor_boot. Image was NOT flashed.\n");
+                                return false;
+                        }
+                }
+        }
+#endif
+
+
+
+#ifdef RODIN_RUNTIME_DTB_FIX
+	/*
+	 * Final rodin vendor_boot v4 topology enforcement.
+	 *
+	 * Required bootable layout:
+	 *   PLATFORM = Zstd(CPIO)
+	 *   RECOVERY = legacy-LZ4(CPIO)
+	 *
+	 * Normalize only PLATFORM. Never recompress recovery here.
+	 */
+	if (is_vendor_boot_v4 &&
+            Patch_Rodin_Usb_Dtb &&
+            rodin_compacted_for_size) {
+
+		const std::string final_image =
+			path + "new-boot.img";
+
+		const std::string norm_dir =
+			path + "rodin-final-normalize/";
+
+		const std::string verify_dir =
+			path + "rodin-final-verify/";
+
+		std::string prep =
+			"rm -rf " + norm_dir + " " + verify_dir +
+			" && mkdir -p " + norm_dir + " " + verify_dir +
+			" && cp -f " + final_image + " " +
+			norm_dir + "boot.img";
+
+		if (TWFunc::Exec_Cmd(prep) != 0) {
+			LOGERR(
+				"Rodin final normalize: failed to prepare workspace.\n");
+			return false;
+		}
+
+		std::string unpack =
+			"cd " + norm_dir + " && " +
+			TWFunc::Get_MagiskBoot() +
+			" unpack -h -n boot.img";
+
+		if (TWFunc::Exec_Cmd(unpack) != 0) {
+			LOGERR(
+				"Rodin final normalize: vendor_boot unpack failed.\n");
+			return false;
+		}
+
+		/*
+		 * Existing rodin helper:
+		 * unwrap PLATFORM completely and rebuild exactly one Zstd layer.
+		 *
+		 * It touches only the type-1 PLATFORM fragment.
+		 */
+		if (!Rodin_Recompress_V4_Platform_To_Zstd(norm_dir)) {
+			LOGERR(
+				"Rodin final normalize: PLATFORM normalization failed.\n");
+			return false;
+		}
+
+		std::string repack =
+			"cd " + norm_dir + " && " +
+			TWFunc::Get_MagiskBoot() +
+			" repack -n boot.img fixed.img";
+
+		if (TWFunc::Exec_Cmd(repack) != 0) {
+			LOGERR(
+				"Rodin final normalize: magiskboot repack -n failed.\n");
+			return false;
+		}
+
+		std::string prepare_verify =
+			"cp -f " + norm_dir + "fixed.img " +
+			verify_dir + "boot.img";
+
+		if (TWFunc::Exec_Cmd(prepare_verify) != 0) {
+			LOGERR(
+				"Rodin final normalize: verification copy failed.\n");
+			return false;
+		}
+
+		std::string verify_unpack =
+			"cd " + verify_dir + " && " +
+			TWFunc::Get_MagiskBoot() +
+			" unpack -h -n boot.img";
+
+		if (TWFunc::Exec_Cmd(verify_unpack) != 0) {
+			LOGERR(
+				"Rodin final normalize: verification unpack failed.\n");
+			return false;
+		}
+
+		/*
+		 * PLATFORM must be Zstd.
+		 */
+		unsigned char platform_magic[4] = {};
+		{
+			std::ifstream f(
+				verify_dir + "vendor_ramdisk_.cpio",
+				std::ios::binary);
+
+			if (!f.read(
+				    reinterpret_cast<char *>(platform_magic),
+				    sizeof(platform_magic))) {
+				LOGERR(
+					"Rodin final normalize: cannot read PLATFORM magic.\n");
+				return false;
+			}
+		}
+
+		const bool platform_is_zstd =
+			platform_magic[0] == 0x28 &&
+			platform_magic[1] == 0xb5 &&
+			platform_magic[2] == 0x2f &&
+			platform_magic[3] == 0xfd;
+
+		if (!platform_is_zstd) {
+			LOGERR(
+				"Rodin final normalize: PLATFORM is not Zstd; "
+				"refusing to flash.\n");
+
+			gui_print_color(
+				"error",
+				"OrangeFox: PLATFORM compression verification failed. "
+				"Image was NOT flashed.\n");
+
+			return false;
+		}
+
+		/*
+		 * Recovery must remain legacy LZ4.
+		 */
+		unsigned char recovery_magic[4] = {};
+		{
+			std::ifstream f(
+				verify_dir + "vendor_ramdisk_recovery.cpio",
+				std::ios::binary);
+
+			if (!f.read(
+				    reinterpret_cast<char *>(recovery_magic),
+				    sizeof(recovery_magic))) {
+				LOGERR(
+					"Rodin final normalize: cannot read recovery magic.\n");
+				return false;
+			}
+		}
+
+		const bool recovery_is_lz4 =
+			recovery_magic[0] == 0x02 &&
+			recovery_magic[1] == 0x21 &&
+			recovery_magic[2] == 0x4c &&
+			recovery_magic[3] == 0x18;
+
+		if (!recovery_is_lz4) {
+			LOGERR(
+				"Rodin final normalize: recovery fragment is not "
+				"legacy LZ4; refusing to flash.\n");
+
+			gui_print_color(
+				"error",
+				"OrangeFox: recovery compression verification failed. "
+				"Image was NOT flashed.\n");
+
+			return false;
+		}
+
+		/*
+		 * Only now replace the candidate image.
+		 * Existing AVB refresh below will repair its descriptor afterward.
+		 */
+		std::string install_fixed =
+			"cp -f " + norm_dir + "fixed.img " +
+			final_image;
+
+		if (TWFunc::Exec_Cmd(install_fixed) != 0) {
+			LOGERR(
+				"Rodin final normalize: failed to install fixed image.\n");
+			return false;
+		}
+
+		LOGINFO(
+			"Rodin final vendor_boot topology verified: "
+			"PLATFORM=Zstd, RECOVERY=legacy-LZ4.\n");
+
+		gui_print_color(
+			"warning",
+			"OrangeFox recovery environment prepared successfully.\n");
+
+		TWFunc::Exec_Cmd(
+			"rm -rf " + norm_dir + " " + verify_dir);
+	}
+#endif
+
+#ifdef RODIN_RUNTIME_DTB_FIX
+	if (is_vendor_boot) {
+		const std::string repacked_image =
+			path + "new-boot.img";
+
+		if (!RefreshRodinVendorBootAvbHash(repacked_image)) {
+			LOGERR("Rodin vendor_boot AVB hash refresh failed; refusing to flash.\n");
+			gui_print_color(
+				"error",
+				"vendor_boot AVB hash repair failed. Image was NOT flashed.\n");
+			return false;
+		}
+	}
+#endif
+
+
+#ifdef RODIN_RUNTIME_DTB_FIX
+        if (is_vendor_boot_v4 && Patch_Rodin_Usb_Dtb) {
+                const std::string rodin_final =
+                        path + "new-boot.img";
+
+                struct stat final_stat {};
+
+                if (stat(rodin_final.c_str(), &final_stat) != 0 ||
+                    final_stat.st_size <= 0) {
+                        LOGERR(
+                                "Rodin auto-reflash: final vendor_boot "
+                                "size check failed.\n");
+                        return false;
+                }
+
+                if (static_cast<long long>(final_stat.st_size) >
+                    kRodinVendorBootLimit) {
+                        LOGERR(
+                                "Rodin auto-reflash: final vendor_boot "
+                                "exceeds physical 64 MiB partition.\n");
+                        gui_print_color(
+                                "error",
+                                "OrangeFox vendor_boot is too large. "
+                                "Image was NOT flashed.\n");
+                        return false;
+                }
+
+                LOGINFO(
+                        "Rodin auto-reflash: final vendor_boot size=%lld "
+                        "bytes; safe to flash.\n",
+                        static_cast<long long>(final_stat.st_size));
+        }
+#endif
+
+#ifdef RODIN_RUNTIME_DTB_FIX
+        if (is_vendor_boot_v4 && Patch_Rodin_Usb_Dtb) {
+                gui_print_color(
+                        "warning",
+                        "\n[ Installing OrangeFox ]\n");
+                gui_print(
+                        "Flashing recovery to the newly installed ROM slot...\n"
+                        "Please wait. Do not reboot or power off the device.\n\n");
+        }
+#endif
+
+DataManager::SetProgress(.75);
+	std::string file = "new-boot.img";
+	DataManager::SetValue("tw_flash_partition", dest_partition + ";");
+	if (!PartitionManager.Flash_Image(path, file)) {
+		LOGINFO("Error flashing new image\n");
+		return false;
+	}
+
+#ifdef RODIN_RUNTIME_DTB_FIX
+        if (is_vendor_boot_v4 && Patch_Rodin_Usb_Dtb) {
+                gui_print_color(
+                        "warning",
+                        "\n[ OrangeFox Auto-Reflash Complete ]\n");
+                gui_print(
+                        "Recovery is ready on the newly installed ROM slot.\n");
+                LOGINFO(
+                        "Rodin auto-reflash: OrangeFox vendor_boot reflash completed.\n");
+        }
+#endif
+
+        DataManager::SetProgress(1);
+	bool switched_slots = false;
+	if (Flash_Both_Slots && part->Is_SlotSelect() && (Repack_Options.Type == REPLACE_RAMDISK || Repack_Options.Type == REPLACE_RAMDISK_UNPACKED)) {
+		LOGINFO("Switching slots to flash ramdisk to both partitions\n");
+		string Current_Slot = PartitionManager.Get_Active_Slot_Display();
+		if (Current_Slot == "A")
+			PartitionManager.Override_Active_Slot("B");
+		else
+			PartitionManager.Override_Active_Slot("A");
+		switched_slots = true;
+		DataManager::SetProgress(.25);
+		PartitionManager.Update_System_Details();
+#if defined(OF_AB_DEVICE_WITH_RECOVERY_PARTITION) || defined(FOX_VENDOR_BOOT_RECOVERY) || defined(BOARD_MOVE_RECOVERY_RESOURCES_TO_VENDOR_BOOT)
+		// skip repacking second recovery partition, just flash prepared image since we assume recovery contains only ramdisk
+		DataManager::SetValue("tw_flash_partition", dest_partition + ";");
+		if (!PartitionManager.Flash_Image(path, file)) {
+			LOGINFO("Error flashing new image\n");
+			return false;
+		}
+#else
+		TWFunc::removeDir(REPACK_ORIG_DIR, false);
+		if (!Backup_Image_For_Repack(part, REPACK_ORIG_DIR, Repack_Options.Backup_First, gui_lookup("repack", "Repack")))
+			return false;
+		if (TWFunc::copy_file(REPACK_NEW_DIR + ramdisk_cpio, REPACK_ORIG_DIR + ramdisk_cpio, 0644)) {
+			LOGERR("Failed to copy ramdisk\n");
+			return false;
+		}
+		path = REPACK_ORIG_DIR;
+		std::string command = "cd " + path + " && " + TWFunc::Get_MagiskBoot() + " repack ";
+
+		if (original_ramdisk_format != image_ramdisk_format) {
+			recompress = true;
+		}
+		command += path + "boot.img";
+
+		if (recompress) {
+			std::string decompress_cmd = TWFunc::Get_MagiskBoot() + " decompress " + orig_compressed_image + " " + copy_compressed_image;
+			if (TWFunc::Exec_Cmd(decompress_cmd) != 0) {
+				gui_msg(Msg(msg::kError, "repack_error=Error repacking image."));
+				return false;
+			}
+			std::rename(copy_compressed_image.c_str(), orig_compressed_image.c_str());
+		}
+
+		if (TWFunc::Exec_Cmd(command) != 0) {
+			gui_msg(Msg(msg::kError, "repack_error=Error repacking image."));
+			return false;
+		}
+		DataManager::SetProgress(.75);
+		std::string file = "new-boot.img";
+		DataManager::SetValue("tw_flash_partition", dest_partition + ";");
+		if (!PartitionManager.Flash_Image(path, file)) {
+			LOGINFO("Error flashing new image\n");
+			return false;
+		}
+#endif
+		DataManager::SetProgress(1);
+		TWFunc::removeDir(REPACK_ORIG_DIR, false);
+	} else {TWFunc::removeDir(REPACK_ORIG_DIR, false);}
+	TWFunc::removeDir(REPACK_NEW_DIR, false);
+	if (dest_partition == "/boot")
+		gui_msg(Msg(msg::kWarning, "repack_overwrite_warning=If device was previously rooted, then root has been overwritten and will need to be reinstalled."));
+	if (switched_slots) {
+		string Current_Slot = PartitionManager.Get_Active_Slot_Display();
+		if (Current_Slot == "A")
+			PartitionManager.Override_Active_Slot("B");
+		else
+			PartitionManager.Override_Active_Slot("A");
+		PartitionManager.Update_System_Details();
+	}
+	return true;
+}
+
+
+bool twrpRepacker::Patch_Rodin_Auto_DFE(bool dry_run) {
+#ifndef RODIN_RUNTIME_DTB_FIX
+	return false;
+#else
+	if (!dry_run &&
+	    DataManager::GetIntValue(FOX_DISABLE_FORCED_ENCRYPTION) != 1)
+		return true;
+
+	if (!dry_run) {
+        const bool data_encrypted =
+                PartitionManager.Storage_Is_Encrypted();
+
+        if (data_encrypted) {
+                gui_print_color(
+                        "warning",
+                        "Auto-DFE: /data is currently encrypted.\n"
+                        "Auto-DFE: Format Data is required once to remove the existing encryption.\n");
+        } else {
+                gui_print(
+                        "Auto-DFE: /data is already unencrypted.\n"
+                        "Auto-DFE: Format Data is not required for encryption removal.\n");
+        }
+}
+
+	std::string slot =
+		android::base::GetProperty("ro.boot.slot_suffix", "");
+
+	if (slot.empty())
+		slot = android::base::GetProperty("ro.boot.slot", "");
+
+	std::string target;
+
+	if (slot == "_a" || slot == "a")
+		target = "_b";
+	else if (slot == "_b" || slot == "b")
+		target = "_a";
+	else {
+		LOGERR("Auto-DFE: cannot determine slot.\n");
+		return false;
+	}
+
+	const std::string block =
+		"/dev/block/by-name/vendor_boot" + target;
+
+	const std::string work = "/tmp/rodin-auto-dfe";
+	const std::string original = work + "/original.img";
+	const std::string output = work + "/new-vendor_boot.img";
+	const std::string lz4_in = work + "/platform.lz4";
+	const std::string cpio = work + "/platform.cpio";
+	const std::string fstab = work + "/auto_dfe_fstab";
+	const std::string lz4_new = work + "/platform-new.lz4";
+
+	const std::string mb = TWFunc::Get_MagiskBoot();
+	const std::string lz4 = "/system/bin/lz4";
+
+	std::string result;
+
+	gui_print("Auto-DFE: target %s\n", block.c_str());
+
+	if (!TWFunc::Path_Exists(block) ||
+	    !TWFunc::Path_Exists(mb) ||
+	    !TWFunc::Path_Exists(lz4)) {
+		LOGERR("Auto-DFE: required file/tool missing.\n");
+		return false;
+	}
+
+	TWFunc::Exec_Cmd(
+		"rm -rf " + work + " && mkdir -p " + work,
+		result);
+
+	if (TWFunc::Exec_Cmd(
+			"dd if=" + block +
+			" of=" + original +
+			" bs=4M",
+			result) != 0) {
+		LOGERR("Auto-DFE: vendor_boot copy failed.\n");
+		return false;
+	}
+
+	int fd = open(original.c_str(), O_RDONLY | O_CLOEXEC);
+	if (fd < 0)
+		return false;
+
+	struct stat image_stat {};
+	if (fstat(fd, &image_stat) != 0) {
+		close(fd);
+		return false;
+	}
+
+	std::vector<uint8_t> header(4096);
+
+	if (pread(fd, header.data(), header.size(), 0) !=
+	    static_cast<ssize_t>(header.size())) {
+		close(fd);
+		return false;
+	}
+
+	if (memcmp(header.data(), "VNDRBOOT", 8) != 0) {
+		close(fd);
+		LOGERR("Auto-DFE: invalid vendor_boot magic.\n");
+		return false;
+	}
+
+	auto le32 = [](const uint8_t* p) -> uint32_t {
+		return static_cast<uint32_t>(p[0]) |
+		       (static_cast<uint32_t>(p[1]) << 8) |
+		       (static_cast<uint32_t>(p[2]) << 16) |
+		       (static_cast<uint32_t>(p[3]) << 24);
+	};
+
+	const uint32_t header_version = le32(header.data() + 8);
+	const uint32_t page_size = le32(header.data() + 12);
+	const uint32_t ramdisk_size = le32(header.data() + 24);
+	const uint32_t dtb_size = le32(header.data() + 2100);
+	const uint32_t table_size = le32(header.data() + 2112);
+	const uint32_t entry_num = le32(header.data() + 2116);
+	const uint32_t entry_size = le32(header.data() + 2120);
+
+	if (header_version != 4 ||
+	    page_size == 0 ||
+	    entry_size < 12 ||
+	    entry_num == 0) {
+		close(fd);
+		LOGERR("Auto-DFE: unsupported vendor_boot layout.\n");
+		return false;
+	}
+
+	auto align_up = [](uint64_t value, uint64_t alignment) {
+		return ((value + alignment - 1) / alignment) * alignment;
+	};
+
+	const uint64_t ramdisk_offset = page_size;
+
+	const uint64_t dtb_offset =
+		ramdisk_offset + align_up(ramdisk_size, page_size);
+
+	const uint64_t table_offset =
+		dtb_offset + align_up(dtb_size, page_size);
+
+	if (static_cast<uint64_t>(entry_num) * entry_size > table_size ||
+	    table_offset + table_size >
+		    static_cast<uint64_t>(image_stat.st_size)) {
+		close(fd);
+		LOGERR("Auto-DFE: invalid vendor ramdisk table.\n");
+		return false;
+	}
+
+	std::vector<uint8_t> table(table_size);
+
+	if (pread(fd, table.data(), table.size(), table_offset) !=
+	    static_cast<ssize_t>(table.size())) {
+		close(fd);
+		return false;
+	}
+
+	uint32_t platform_size = 0;
+	uint32_t platform_offset = 0;
+	uint64_t platform_table_entry_absolute = 0;
+	bool platform_found = false;
+
+	for (uint32_t i = 0; i < entry_num; ++i) {
+		const uint8_t* e =
+			table.data() + static_cast<size_t>(i) * entry_size;
+
+		const uint32_t size = le32(e);
+		const uint32_t offset = le32(e + 4);
+		const uint32_t type = le32(e + 8);
+
+		if (type == 1) {
+			if (platform_found ||
+			    static_cast<uint64_t>(offset) + size > ramdisk_size) {
+				close(fd);
+				LOGERR("Auto-DFE: invalid PLATFORM fragment.\n");
+				return false;
+			}
+
+			platform_size = size;
+			platform_offset = offset;
+			platform_table_entry_absolute =
+				table_offset + static_cast<uint64_t>(i) * entry_size;
+			platform_found = true;
+		}
+	}
+
+	if (!platform_found || platform_size < 8) {
+		close(fd);
+		LOGERR("Auto-DFE: PLATFORM fragment missing.\n");
+		return false;
+	}
+
+	const uint64_t platform_absolute =
+		ramdisk_offset + platform_offset;
+
+	std::vector<uint8_t> platform(platform_size);
+
+	if (pread(
+			fd,
+			platform.data(),
+			platform.size(),
+			platform_absolute) !=
+	    static_cast<ssize_t>(platform.size())) {
+		close(fd);
+		return false;
+	}
+
+	close(fd);
+
+        const uint8_t legacy_magic[4] = {
+                0x02, 0x21, 0x4c, 0x18
+        };
+
+        const uint8_t zstd_magic[4] = {
+                0x28, 0xb5, 0x2f, 0xfd
+        };
+
+        enum class AutoDfeCompressionLayer {
+                LegacyLz4,
+                Zstd
+        };
+
+        std::vector<AutoDfeCompressionLayer>
+                auto_dfe_compression_stack;
+
+        auto auto_dfe_is_newc =
+                [](const std::vector<uint8_t>& data) -> bool {
+                        return data.size() >= 6 &&
+                               (memcmp(data.data(),
+                                       "070701", 6) == 0 ||
+                                memcmp(data.data(),
+                                       "070702", 6) == 0);
+                };
+
+        auto auto_dfe_is_legacy_lz4 =
+                [&](const std::vector<uint8_t>& data) -> bool {
+                        return data.size() >=
+                                       sizeof(legacy_magic) &&
+                               memcmp(data.data(),
+                                      legacy_magic,
+                                      sizeof(legacy_magic)) == 0;
+                };
+
+        auto auto_dfe_is_zstd =
+                [&](const std::vector<uint8_t>& data) -> bool {
+                        return data.size() >=
+                                       sizeof(zstd_magic) &&
+                               memcmp(data.data(),
+                                      zstd_magic,
+                                      sizeof(zstd_magic)) == 0;
+                };
+
+        auto auto_dfe_write_blob =
+                [](const std::string& path,
+                   const std::vector<uint8_t>& data) -> bool {
+                        std::ofstream out(
+                                path,
+                                std::ios::binary |
+                                std::ios::trunc);
+
+                        if (!out)
+                                return false;
+
+                        out.write(
+                                reinterpret_cast<const char*>(
+                                        data.data()),
+                                static_cast<std::streamsize>(
+                                        data.size()));
+
+                        return static_cast<bool>(out);
+                };
+
+        auto auto_dfe_read_blob =
+                [](const std::string& path,
+                   std::vector<uint8_t>& data) -> bool {
+                        struct stat st {};
+
+                        if (stat(path.c_str(), &st) != 0 ||
+                            st.st_size <= 0 ||
+                            static_cast<uint64_t>(st.st_size) >
+                                    512ULL * 1024ULL * 1024ULL)
+                                return false;
+
+                        data.resize(
+                                static_cast<size_t>(
+                                        st.st_size));
+
+                        std::ifstream in(
+                                path,
+                                std::ios::binary);
+
+                        if (!in)
+                                return false;
+
+                        in.read(
+                                reinterpret_cast<char*>(
+                                        data.data()),
+                                static_cast<std::streamsize>(
+                                        data.size()));
+
+                        return static_cast<bool>(in);
+                };
+
+        auto auto_dfe_decode_zstd =
+                [&](const std::vector<uint8_t>& input,
+                    std::vector<uint8_t>& output) -> bool {
+                        const unsigned long long decoded_size =
+                                ZSTD_getFrameContentSize(
+                                        input.data(),
+                                        input.size());
+
+                        if (decoded_size ==
+                                    ZSTD_CONTENTSIZE_ERROR ||
+                            decoded_size ==
+                                    ZSTD_CONTENTSIZE_UNKNOWN ||
+                            decoded_size == 0 ||
+                            decoded_size >
+                                    512ULL * 1024ULL * 1024ULL) {
+                                LOGERR(
+                                        "Auto-DFE: invalid nested Zstd frame size.\n");
+                                return false;
+                        }
+
+                        output.resize(
+                                static_cast<size_t>(
+                                        decoded_size));
+
+                        const size_t actual =
+                                ZSTD_decompress(
+                                        output.data(),
+                                        output.size(),
+                                        input.data(),
+                                        input.size());
+
+                        if (ZSTD_isError(actual) ||
+                            actual != output.size()) {
+                                LOGERR(
+                                        "Auto-DFE: nested Zstd decompression failed: %s\n",
+                                        ZSTD_isError(actual)
+                                                ? ZSTD_getErrorName(actual)
+                                                : "decoded size mismatch");
+                                return false;
+                        }
+
+                        return true;
+                };
+
+        auto auto_dfe_decode_lz4 =
+                [&](const std::vector<uint8_t>& input,
+                    std::vector<uint8_t>& output) -> bool {
+                        const std::string layer_in =
+                                work + "/auto-dfe-layer.lz4";
+
+                        const std::string layer_out =
+                                work + "/auto-dfe-layer.raw";
+
+                        if (!auto_dfe_write_blob(
+                                    layer_in,
+                                    input)) {
+                                LOGERR(
+                                        "Auto-DFE: cannot write nested LZ4 layer.\n");
+                                return false;
+                        }
+
+                        unlink(layer_out.c_str());
+
+                        std::string layer_result;
+
+                        if (TWFunc::Exec_Cmd(
+                                    lz4 + " -d " +
+                                    layer_in + " " +
+                                    layer_out,
+                                    layer_result) != 0) {
+                                LOGERR(
+                                        "Auto-DFE: nested PLATFORM LZ4 decompression failed.\n");
+                                return false;
+                        }
+
+                        if (!auto_dfe_read_blob(
+                                    layer_out,
+                                    output)) {
+                                LOGERR(
+                                        "Auto-DFE: cannot read nested LZ4 output.\n");
+                                return false;
+                        }
+
+                        unlink(layer_in.c_str());
+                        unlink(layer_out.c_str());
+
+                        return true;
+                };
+
+        /*
+         * Generic PLATFORM decoder.
+         *
+         * Keep unwrapping supported compression layers until
+         * an actual newc CPIO archive is reached. Every layer is
+         * recorded so the exact compression topology can later be
+         * rebuilt in reverse.
+         */
+        std::vector<uint8_t> decoded_platform =
+                platform;
+
+        constexpr int kAutoDfeMaxCompressionDepth = 4;
+
+        for (int depth = 0;
+             depth < kAutoDfeMaxCompressionDepth;
+             ++depth) {
+
+                if (auto_dfe_is_newc(
+                            decoded_platform))
+                        break;
+
+                std::vector<uint8_t> next_layer;
+
+                if (auto_dfe_is_legacy_lz4(
+                            decoded_platform)) {
+
+                        gui_print(
+                                "Auto-DFE: PLATFORM layer %d: legacy LZ4.\n",
+                                depth + 1);
+
+                        auto_dfe_compression_stack.push_back(
+                                AutoDfeCompressionLayer::
+                                        LegacyLz4);
+
+                        if (!auto_dfe_decode_lz4(
+                                    decoded_platform,
+                                    next_layer))
+                                return false;
+
+                } else if (auto_dfe_is_zstd(
+                                   decoded_platform)) {
+
+                        gui_print(
+                                "Auto-DFE: PLATFORM layer %d: Zstd.\n",
+                                depth + 1);
+
+                        auto_dfe_compression_stack.push_back(
+                                AutoDfeCompressionLayer::
+                                        Zstd);
+
+                        if (!auto_dfe_decode_zstd(
+                                    decoded_platform,
+                                    next_layer))
+                                return false;
+
+                } else {
+                        if (decoded_platform.size() >= 6) {
+                                LOGERR(
+                                        "Auto-DFE: unsupported PLATFORM layer "
+                                        "(magic %02x %02x %02x %02x %02x %02x).\n",
+                                        decoded_platform[0],
+                                        decoded_platform[1],
+                                        decoded_platform[2],
+                                        decoded_platform[3],
+                                        decoded_platform[4],
+                                        decoded_platform[5]);
+                        } else {
+                                LOGERR(
+                                        "Auto-DFE: PLATFORM layer is too small.\n");
+                        }
+
+                        return false;
+                }
+
+                if (next_layer.empty()) {
+                        LOGERR(
+                                "Auto-DFE: decoded PLATFORM layer is empty.\n");
+                        return false;
+                }
+
+                decoded_platform.swap(
+                        next_layer);
+        }
+
+        if (!auto_dfe_is_newc(
+                    decoded_platform)) {
+                LOGERR(
+                        "Auto-DFE: unable to reach raw PLATFORM CPIO "
+                        "within %d layers.\n",
+                        kAutoDfeMaxCompressionDepth);
+                return false;
+        }
+
+        if (!auto_dfe_write_blob(
+                    cpio,
+                    decoded_platform)) {
+                LOGERR(
+                        "Auto-DFE: cannot write decoded PLATFORM CPIO.\n");
+                return false;
+        }
+
+        gui_print(
+                "Auto-DFE: decoded PLATFORM CPIO verified "
+                "(%zu bytes, %zu compression layer%s).\n",
+                decoded_platform.size(),
+                auto_dfe_compression_stack.size(),
+                auto_dfe_compression_stack.size() == 1
+                        ? ""
+                        : "s");
+
+        /*
+         * Discover the real userdata fstab directly from PLATFORM CPIO.
+         *
+         * No hardcoded SoC filename or archive path.
+         * No full ramdisk extraction.
+         */
+        const std::vector<uint8_t>& archive =
+                decoded_platform;
+
+        auto align4 =
+                [](size_t value) -> size_t {
+                        return (value + 3U) &
+                               ~static_cast<size_t>(3U);
+                };
+
+        auto parse_hex8 =
+                [&](size_t pos,
+                    uint32_t& value) -> bool {
+                        if (pos + 8 > archive.size())
+                                return false;
+
+                        uint32_t out = 0;
+
+                        for (size_t i = 0; i < 8; ++i) {
+                                const uint8_t ch =
+                                        archive[pos + i];
+
+                                uint32_t digit;
+
+                                if (ch >= '0' && ch <= '9')
+                                        digit = ch - '0';
+                                else if (ch >= 'a' && ch <= 'f')
+                                        digit = ch - 'a' + 10;
+                                else if (ch >= 'A' && ch <= 'F')
+                                        digit = ch - 'A' + 10;
+                                else
+                                        return false;
+
+                                out = (out << 4) | digit;
+                        }
+
+                        value = out;
+                        return true;
+                };
+
+        auto normalize_entry =
+                [](std::string value) -> std::string {
+                        while (value.compare(0, 2, "./") == 0)
+                                value.erase(0, 2);
+
+                        while (!value.empty() &&
+                               value.front() == '/')
+                                value.erase(0, 1);
+
+                        return value;
+                };
+
+        struct AutoDfeCandidate {
+                std::string entry;
+                std::string contents;
+                bool has_persist;
+        };
+
+        std::vector<AutoDfeCandidate> candidates;
+
+        size_t off = 0;
+
+        while (off + 110 <= archive.size()) {
+                const std::string magic(
+                        reinterpret_cast<const char*>(
+                                archive.data() + off),
+                        6);
+
+                if (magic != "070701" &&
+                    magic != "070702") {
+                        LOGERR(
+                                "Auto-DFE: unsupported PLATFORM CPIO at offset %zu.\n",
+                                off);
+                        return false;
+                }
+
+                uint32_t filesize = 0;
+                uint32_t namesize = 0;
+
+                if (!parse_hex8(off + 54, filesize) ||
+                    !parse_hex8(off + 94, namesize) ||
+                    namesize == 0) {
+                        LOGERR("Auto-DFE: malformed PLATFORM CPIO header.\n");
+                        return false;
+                }
+
+                const size_t name_start = off + 110;
+                const size_t name_end =
+                        name_start + static_cast<size_t>(namesize);
+
+                if (name_end > archive.size()) {
+                        LOGERR("Auto-DFE: malformed PLATFORM CPIO name.\n");
+                        return false;
+                }
+
+                size_t real_name_size =
+                        static_cast<size_t>(namesize);
+
+                if (real_name_size &&
+                    archive[name_end - 1] == 0)
+                        --real_name_size;
+
+                const std::string entry(
+                        reinterpret_cast<const char*>(
+                                archive.data() + name_start),
+                        real_name_size);
+
+                const size_t data_start =
+                        align4(name_end);
+
+                const size_t data_end =
+                        data_start +
+                        static_cast<size_t>(filesize);
+
+                if (data_start > archive.size() ||
+                    data_end > archive.size()) {
+                        LOGERR("Auto-DFE: malformed PLATFORM CPIO payload.\n");
+                        return false;
+                }
+
+                const size_t next =
+                        align4(data_end);
+
+                if (entry == "TRAILER!!!") {
+                        off = next;
+
+                        while (off < archive.size() &&
+                               archive[off] == 0)
+                                ++off;
+
+                        if (off + 6 <= archive.size()) {
+                                const std::string next_magic(
+                                        reinterpret_cast<const char*>(
+                                                archive.data() + off),
+                                        6);
+
+                                if (next_magic == "070701" ||
+                                    next_magic == "070702")
+                                        continue;
+                        }
+
+                        break;
+                }
+
+                const std::string normalized =
+                        normalize_entry(entry);
+
+                const size_t slash =
+                        normalized.find_last_of('/');
+
+                const std::string basename =
+                        slash == std::string::npos
+                                ? normalized
+                                : normalized.substr(slash + 1);
+
+                if (filesize &&
+                    basename.compare(0, 5, "fstab") == 0) {
+
+                        const std::string contents(
+                                reinterpret_cast<const char*>(
+                                        archive.data() + data_start),
+                                static_cast<size_t>(filesize));
+
+                        std::istringstream input(contents);
+                        std::string current;
+
+                        bool has_data = false;
+                        bool has_persist = false;
+
+                        while (std::getline(input, current)) {
+                                if (current.empty() ||
+                                    current[0] == '#')
+                                        continue;
+
+                                std::istringstream fields(current);
+
+                                std::string device;
+                                std::string mount_point;
+                                std::string fs_type;
+
+                                if (!(fields >>
+                                      device >>
+                                      mount_point >>
+                                      fs_type))
+                                        continue;
+
+                                if (mount_point == "/data")
+                                        has_data = true;
+
+                                if (mount_point ==
+                                    "/mnt/vendor/persist")
+                                        has_persist = true;
+                        }
+
+                        if (has_data) {
+                                candidates.push_back(
+                                        {entry, contents, has_persist});
+                        }
+                }
+
+                off = next;
+        }
+
+        if (candidates.empty()) {
+                LOGERR(
+                        "Auto-DFE: no PLATFORM fstab containing /data found.\n");
+                return false;
+        }
+
+        const AutoDfeCandidate* selected = nullptr;
+
+        /*
+         * Prefer first-stage + persist because that matches
+         * the existing proven DFE carrier logic.
+         */
+        for (const auto& candidate : candidates) {
+                if (!candidate.has_persist)
+                        continue;
+
+                const std::string normalized =
+                        normalize_entry(candidate.entry);
+
+                const size_t slash =
+                        normalized.find_last_of('/');
+
+                const std::string parent =
+                        slash == std::string::npos
+                                ? std::string()
+                                : normalized.substr(0, slash);
+
+                if (parent == "first_stage_ramdisk") {
+                        selected = &candidate;
+                        break;
+                }
+        }
+
+        if (!selected) {
+                for (const auto& candidate : candidates) {
+                        if (!candidate.has_persist)
+                                continue;
+
+                        const std::string normalized =
+                                normalize_entry(candidate.entry);
+
+                        if (normalized.compare(
+                                    0,
+                                    sizeof("first_stage_ramdisk/") - 1,
+                                    "first_stage_ramdisk/") == 0) {
+                                selected = &candidate;
+                                break;
+                        }
+                }
+        }
+
+        if (!selected) {
+                for (const auto& candidate : candidates) {
+                        if (candidate.has_persist) {
+                                selected = &candidate;
+                                break;
+                        }
+                }
+        }
+
+        if (!selected)
+                selected = &candidates.front();
+
+        const std::string fstab_entry =
+                selected->entry;
+
+        const std::string normalized_fstab_entry =
+                normalize_entry(fstab_entry);
+
+        const size_t fstab_name_pos =
+                normalized_fstab_entry.find_last_of('/');
+
+        const std::string fstab_name =
+                fstab_name_pos == std::string::npos
+                        ? normalized_fstab_entry
+                        : normalized_fstab_entry.substr(
+                                fstab_name_pos + 1);
+
+        {
+                std::ofstream out(
+                        fstab,
+                        std::ios::binary |
+                        std::ios::trunc);
+
+                if (!out) {
+                        LOGERR("Auto-DFE: cannot create extracted fstab.\n");
+                        return false;
+                }
+
+                out.write(
+                        selected->contents.data(),
+                        static_cast<std::streamsize>(
+                                selected->contents.size()));
+
+                if (!out) {
+                        LOGERR("Auto-DFE: cannot write extracted fstab.\n");
+                        return false;
+                }
+        }
+
+        gui_print(
+                "Auto-DFE: detected userdata fstab: %s\n",
+                fstab_entry.c_str());
+
+	std::ifstream in(fstab);
+	if (!in)
+		return false;
+
+	std::vector<std::string> lines;
+	std::string line;
+
+	bool userdata_found = false;
+        bool persist_found = false;
+	bool changed = false;
+
+	auto remove_flag =
+		[&](std::string& value, const std::string& key) {
+			size_t p = 0;
+
+			while ((p = value.find(key, p)) != std::string::npos) {
+				size_t begin = p;
+
+				size_t finish =
+					value.find_first_of(", \t\r\n", p);
+
+				if (finish == std::string::npos)
+					finish = value.size();
+
+				if (begin > 0 && value[begin - 1] == ',')
+					--begin;
+				else if (finish < value.size() &&
+					 value[finish] == ',')
+					++finish;
+
+				value.erase(begin, finish - begin);
+				changed = true;
+				p = begin;
+			}
+		};
+
+	while (std::getline(in, line)) {
+		if (line.find("/dev/block/by-name/userdata") !=
+			    std::string::npos &&
+		    line.find("/data") != std::string::npos) {
+
+			userdata_found = true;
+
+			remove_flag(line, "fileencryption=");
+			remove_flag(line, "keydirectory=");
+			remove_flag(line, "metadata_encryption=");
+			remove_flag(line, "forceencrypt=");
+			remove_flag(line, "forcefdeorfbe=");
+			remove_flag(line, "encryptable=");
+		}
+
+
+                if (line.find("/dev/block/by-name/persist") !=
+                            std::string::npos &&
+                    line.find("/mnt/vendor/persist") !=
+                            std::string::npos) {
+
+                        persist_found = true;
+
+                        if (line.find("first_stage_mount") ==
+                            std::string::npos) {
+                                line += ",first_stage_mount";
+                        }
+                }
+
+                lines.push_back(line);
+	}
+
+	in.close();
+
+	if (!userdata_found) {
+		LOGERR("Auto-DFE: userdata fstab row missing.\n");
+		return false;
+	}
+
+        if (!persist_found) {
+                LOGERR("Auto-DFE: persist fstab row missing.\n");
+                return false;
+        }
+
+        /*
+         * Real DFE late-fstab carrier.
+         *
+         * Clean copy:
+         *     vendor_boot DTB /fox_dfe/metadata
+         *
+         * Runtime:
+         *     /proc/device-tree/fox_dfe/metadata
+         *
+         * This file is bind-mounted over the immutable vendor fstab
+         * during first-stage mount.
+         */
+        const std::string dfe_late_fstab =
+                work + "/auto_dfe_fstab.dfe";
+
+        const std::string dfe_bind_entry =
+                "/mnt/vendor/persist/fox_dfe/persist /vendor/etc/" +
+                fstab_name +
+                " none bind first_stage_mount,nofail";
+
+
+        /*
+         * Carrier is the clean fstab WITHOUT its own bind row.
+         */
+        {
+                std::ofstream out(
+                        dfe_late_fstab,
+                        std::ios::trunc);
+
+                if (!out) {
+                        LOGERR(
+                                "Auto-DFE: cannot create clean late fstab.\n");
+                        return false;
+                }
+
+                for (const auto& current :
+                     lines) {
+
+                        if (current ==
+                            dfe_bind_entry)
+                                continue;
+
+                        out << current
+                            << '\n';
+                }
+
+                if (!out)
+                        return false;
+        }
+
+
+        bool bind_found = false;
+
+        for (const auto& current :
+             lines) {
+
+                if (current ==
+                    dfe_bind_entry) {
+
+                        bind_found = true;
+                        break;
+                }
+        }
+
+
+        if (!bind_found) {
+
+                lines.push_back(
+                        dfe_bind_entry);
+
+                changed = true;
+        }
+
+
+        if (!changed) {
+
+                gui_print(
+                        "Auto-DFE: refreshing persistent DTB carrier.\n");
+        }
+
+
+        /*
+         * Main first-stage fstab:
+         *
+         * - encryption removed from /data
+         * - late vendor-fstab bind appended
+         */
+        {
+                std::ofstream out(
+                        fstab,
+                        std::ios::trunc);
+
+                if (!out)
+                        return false;
+
+                for (const auto& current :
+                     lines) {
+
+                        out << current
+                            << '\n';
+                }
+
+                if (!out)
+                        return false;
+        }
+
+
+        if (TWFunc::Exec_Cmd(
+                        "cd " + work + " && " +
+                        mb +
+                        " cpio platform.cpio \"add 0644 " +
+                        fstab_entry +
+                        " auto_dfe_fstab\"",
+                        result) != 0) {
+
+                LOGERR(
+                        "Auto-DFE: CPIO update failed.\n");
+
+                return false;
+        }
+
+        /*
+         * Rebuild the exact PLATFORM compression topology.
+         *
+         * Example:
+         *   decode:  LZ4 -> Zstd -> CPIO
+         *   rebuild: CPIO -> Zstd -> LZ4
+         */
+        std::vector<uint8_t> new_platform;
+
+        if (!auto_dfe_read_blob(
+                    cpio,
+                    new_platform)) {
+                LOGERR(
+                        "Auto-DFE: rebuilt PLATFORM CPIO is invalid.\n");
+                return false;
+        }
+
+        for (auto layer =
+                     auto_dfe_compression_stack.rbegin();
+             layer !=
+                     auto_dfe_compression_stack.rend();
+             ++layer) {
+
+                if (*layer ==
+                    AutoDfeCompressionLayer::Zstd) {
+
+                        const size_t bound =
+                                ZSTD_compressBound(
+                                        new_platform.size());
+
+                        if (bound == 0) {
+                                LOGERR(
+                                        "Auto-DFE: invalid nested Zstd compression bound.\n");
+                                return false;
+                        }
+
+                        std::vector<uint8_t>
+                                compressed(bound);
+
+                        const size_t compressed_size =
+                                ZSTD_compress(
+                                        compressed.data(),
+                                        compressed.size(),
+                                        new_platform.data(),
+                                        new_platform.size(),
+                                        19);
+
+                        if (ZSTD_isError(
+                                    compressed_size)) {
+                                LOGERR(
+                                        "Auto-DFE: nested Zstd recompression failed: %s\n",
+                                        ZSTD_getErrorName(
+                                                compressed_size));
+                                return false;
+                        }
+
+                        compressed.resize(
+                                compressed_size);
+
+                        new_platform.swap(
+                                compressed);
+
+                } else if (*layer ==
+                           AutoDfeCompressionLayer::
+                                   LegacyLz4) {
+
+                        const std::string layer_in =
+                                work +
+                                "/auto-dfe-repack.raw";
+
+                        const std::string layer_out =
+                                work +
+                                "/auto-dfe-repack.lz4";
+
+                        if (!auto_dfe_write_blob(
+                                    layer_in,
+                                    new_platform)) {
+                                LOGERR(
+                                        "Auto-DFE: cannot write LZ4 rebuild input.\n");
+                                return false;
+                        }
+
+                        unlink(layer_out.c_str());
+
+                        std::string layer_result;
+
+                        if (TWFunc::Exec_Cmd(
+                                    lz4 + " -l -12 " +
+                                    layer_in + " " +
+                                    layer_out,
+                                    layer_result) != 0) {
+                                LOGERR(
+                                        "Auto-DFE: nested PLATFORM LZ4 recompression failed.\n");
+                                return false;
+                        }
+
+                        std::vector<uint8_t>
+                                compressed;
+
+                        if (!auto_dfe_read_blob(
+                                    layer_out,
+                                    compressed)) {
+                                LOGERR(
+                                        "Auto-DFE: cannot read LZ4 rebuild output.\n");
+                                return false;
+                        }
+
+                        new_platform.swap(
+                                compressed);
+
+                        unlink(layer_in.c_str());
+                        unlink(layer_out.c_str());
+                }
+        }
+
+        if (new_platform.empty() ||
+            new_platform.size() >
+                    platform_size) {
+                LOGERR(
+                        "Auto-DFE: rebuilt PLATFORM does not fit "
+                        "(old=%u new=%zu).\n",
+                        platform_size,
+                        new_platform.size());
+                return false;
+        }
+
+        gui_print(
+                "Auto-DFE: rebuilt PLATFORM with %zu compression layer%s "
+                "(%zu bytes).\n",
+                auto_dfe_compression_stack.size(),
+                auto_dfe_compression_stack.size() == 1
+                        ? ""
+                        : "s",
+                new_platform.size());
+
+	if (TWFunc::Exec_Cmd(
+			"cp -f " + original + " " + output,
+			result) != 0)
+		return false;
+
+	int out_fd = open(
+		output.c_str(),
+		O_RDWR | O_CLOEXEC);
+
+	if (out_fd < 0)
+		return false;
+
+        /*
+         * vendor_boot v4 ramdisk fragments are packed back-to-back.
+         *
+         * Recompression may make PLATFORM smaller. In that case we must
+         * compact everything after PLATFORM, update following fragment
+         * offsets, and publish the new total vendor_ramdisk_size.
+         *
+         * DTB/table may stay at their existing absolute offsets only while
+         * the page-aligned ramdisk extent remains unchanged.
+         */
+        const uint32_t new_platform_size =
+                static_cast<uint32_t>(new_platform.size());
+
+        if (new_platform_size > platform_size) {
+                close(out_fd);
+                LOGERR("Auto-DFE: rebuilt PLATFORM grew unexpectedly.\n");
+                return false;
+        }
+
+        const uint32_t shrink =
+                platform_size - new_platform_size;
+
+        const uint64_t old_platform_end =
+                static_cast<uint64_t>(platform_offset) +
+                platform_size;
+
+        if (old_platform_end > ramdisk_size) {
+                close(out_fd);
+                LOGERR("Auto-DFE: PLATFORM exceeds vendor ramdisk.\n");
+                return false;
+        }
+
+        const uint32_t new_ramdisk_size =
+                ramdisk_size - shrink;
+
+        /*
+         * Keep the original vendor_boot physical geometry for this
+         * intermediate image.
+         *
+         * PLATFORM and the following ramdisk fragments are compacted
+         * below and their table entries are updated, but the header's
+         * vendor_ramdisk_size is intentionally left unchanged here.
+         *
+         * That keeps the existing DTB and ramdisk-table physical
+         * offsets valid while the freed end of the ramdisk section is
+         * zero-filled. The later MagiskBoot unpack/repack stage then
+         * rebuilds the final vendor_boot layout canonically using the
+         * new fragment sizes.
+         */
+
+        /*
+         * Save everything physically following PLATFORM before writing.
+         * This includes all later vendor ramdisk fragments.
+         */
+        const uint64_t tail_size =
+                static_cast<uint64_t>(ramdisk_size) -
+                old_platform_end;
+
+        std::vector<uint8_t> ramdisk_tail(
+                static_cast<size_t>(tail_size));
+
+        if (tail_size != 0) {
+                if (pread(
+                                out_fd,
+                                ramdisk_tail.data(),
+                                ramdisk_tail.size(),
+                                ramdisk_offset + old_platform_end) !=
+                    static_cast<ssize_t>(ramdisk_tail.size())) {
+                        close(out_fd);
+                        LOGERR("Auto-DFE: failed reading vendor ramdisk tail.\n");
+                        return false;
+                }
+        }
+
+        /*
+         * Write rebuilt PLATFORM at its original start offset.
+         */
+        if (pwrite(
+                        out_fd,
+                        new_platform.data(),
+                        new_platform.size(),
+                        platform_absolute) !=
+            static_cast<ssize_t>(new_platform.size())) {
+                close(out_fd);
+                LOGERR("Auto-DFE: PLATFORM write failed.\n");
+                return false;
+        }
+
+        /*
+         * Compact every byte after PLATFORM directly behind the new,
+         * smaller PLATFORM.
+         */
+        if (tail_size != 0) {
+                const uint64_t new_tail_absolute =
+                        ramdisk_offset +
+                        static_cast<uint64_t>(platform_offset) +
+                        new_platform_size;
+
+                if (pwrite(
+                                out_fd,
+                                ramdisk_tail.data(),
