+				uint8_t* digest =
+					variable +
+					hash.partition_name_len +
+					hash.salt_len;
+
+				SHA256_CTX sha {};
+				if (SHA256_Init(&sha) != 1)
+					return fail(
+						"SHA256_Init failed");
+
+				if (hash.salt_len != 0 &&
+				    SHA256_Update(
+					    &sha,
+					    salt,
+					    hash.salt_len) != 1) {
+					return fail(
+						"unable to hash AVB salt");
+				}
+
+				constexpr size_t kBufferSize =
+					1024 * 1024;
+				std::vector<uint8_t> buffer(
+					kBufferSize);
+
+				uint64_t remaining =
+					hash.image_size;
+				off_t image_offset = 0;
+
+				while (remaining != 0) {
+					const size_t want =
+						static_cast<size_t>(
+							std::min<uint64_t>(
+								remaining,
+								buffer.size()));
+
+					const ssize_t got =
+						pread(
+							fd,
+							buffer.data(),
+							want,
+							image_offset);
+
+					if (got <= 0)
+						return fail(
+							"unable to read vendor_boot payload");
+
+					if (SHA256_Update(
+						    &sha,
+						    buffer.data(),
+						    got) != 1)
+						return fail(
+							"unable to hash vendor_boot payload");
+
+					image_offset += got;
+					remaining -= got;
+				}
+
+				uint8_t calculated[
+					SHA256_DIGEST_LENGTH];
+
+				if (SHA256_Final(
+					    calculated,
+					    &sha) != 1)
+					return fail(
+						"SHA256_Final failed");
+
+				memcpy(
+					digest,
+					calculated,
+					sizeof(calculated));
+
+				patched = true;
+
+				LOGINFO(
+					"Rodin AVB: refreshed vendor_boot SHA-256 descriptor "
+					"(image_size=%" PRIu64 ", salt_len=%u)\n",
+					hash.image_size,
+					hash.salt_len);
+			}
+		}
+
+		offset += total;
+	}
+
+	if (!patched)
+		return fail(
+			"vendor_boot SHA-256 descriptor not found");
+
+	if (pwrite(fd,
+	           vbmeta.data(),
+	           vbmeta.size(),
+	           footer.vbmeta_offset) !=
+	    static_cast<ssize_t>(vbmeta.size())) {
+		return fail("unable to write refreshed VBMeta");
+	}
+
+	if (fsync(fd) != 0)
+		return fail("fsync failed");
+
+	close(fd);
+	return true;
+}
+
+constexpr unsigned char kRodinMtkContainerMagic[4] = {
+	0xd7, 0xb7, 0xab, 0x1e
+};
+
+constexpr unsigned char kFdtMagicBytes[4] = {
+	0xd0, 0x0d, 0xfe, 0xed
+};
+
+constexpr const char* kRodinUsbNode =
+	"/soc/usb0@11201000/xhci0@11200000";
+
+constexpr const char* kRodinUsbOffloadProperty =
+	"mediatek,usb-offload";
+
+constexpr const char* kRodinXhciCompatible =
+	"mediatek,mtk-xhci";
+
+enum class RodinDtbPatchResult {
+	NotFound,
+	Success,
+	Error,
+};
+
+uint32_t RodinReadBe32(const unsigned char* p) {
+	return
+		(static_cast<uint32_t>(p[0]) << 24) |
+		(static_cast<uint32_t>(p[1]) << 16) |
+		(static_cast<uint32_t>(p[2]) << 8) |
+		static_cast<uint32_t>(p[3]);
+}
+
+bool RodinHasMagic(
+	const unsigned char* data,
+	const unsigned char magic[4]) {
+	return std::memcmp(data, magic, 4) == 0;
+}
+
+bool RodinCompatibleIsExpected(
+	const void* fdt,
+	int node) {
+
+	int length = 0;
+	const char* compatible =
+		static_cast<const char*>(
+			fdt_getprop(
+				fdt,
+				node,
+				"compatible",
+				&length));
+
+	if (!compatible || length <= 0)
+		return false;
+
+	int offset = 0;
+
+	while (offset < length) {
+		const size_t remaining =
+			static_cast<size_t>(length - offset);
+
+		const size_t current_length =
+			strnlen(compatible + offset, remaining);
+
+		if (current_length >= remaining)
+			return false;
+
+		if (std::string(
+				compatible + offset,
+				current_length) ==
+		    kRodinXhciCompatible) {
+			return true;
+		}
+
+		offset +=
+			static_cast<int>(current_length) + 1;
+	}
+
+	return false;
+}
+
+RodinDtbPatchResult RodinPatchDtbFile(
+	const std::string& path) {
+
+	std::ifstream input(
+		path,
+		std::ios::binary | std::ios::ate);
+
+	if (!input)
+		return RodinDtbPatchResult::NotFound;
+
+	const std::streamsize file_size =
+		input.tellg();
+
+	if (file_size < 4)
+		return RodinDtbPatchResult::NotFound;
+
+	std::vector<unsigned char> blob(
+		static_cast<size_t>(file_size));
+
+	input.seekg(0, std::ios::beg);
+
+	if (!input.read(
+			reinterpret_cast<char*>(blob.data()),
+			file_size)) {
+		return RodinDtbPatchResult::NotFound;
+	}
+
+	size_t fdt_offset = 0;
+	size_t fdt_length = blob.size();
+
+	if (RodinHasMagic(
+		    blob.data(),
+		    kRodinMtkContainerMagic)) {
+
+		/*
+		 * MediaTek container layout used by rodin:
+		 *
+		 *   +0x00  container magic
+		 *   +0x04  total container length (BE32)
+		 *   +0x20  embedded FDT length (BE32)
+		 *   +0x24  embedded FDT offset (BE32)
+		 */
+		if (blob.size() < 64) {
+			LOGERR(
+				"Rodin DTB: MediaTek container too small: %s\n",
+				path.c_str());
+			return RodinDtbPatchResult::Error;
+		}
+
+		const uint32_t recorded_total =
+			RodinReadBe32(blob.data() + 4);
+
+		const uint32_t embedded_length =
+			RodinReadBe32(blob.data() + 32);
+
+		const uint32_t embedded_offset =
+			RodinReadBe32(blob.data() + 36);
+
+		if (recorded_total != blob.size() ||
+		    embedded_offset < 64 ||
+		    embedded_length == 0 ||
+		    static_cast<size_t>(embedded_offset) +
+		            static_cast<size_t>(embedded_length) >
+		        blob.size()) {
+
+			LOGERR(
+				"Rodin DTB: invalid MediaTek container: %s\n",
+				path.c_str());
+
+			return RodinDtbPatchResult::Error;
+		}
+
+		fdt_offset = embedded_offset;
+		fdt_length = embedded_length;
+
+		if (fdt_length < 4 ||
+		    !RodinHasMagic(
+			    blob.data() + fdt_offset,
+			    kFdtMagicBytes)) {
+
+			LOGERR(
+				"Rodin DTB: embedded payload is not an FDT: %s\n",
+				path.c_str());
+
+			return RodinDtbPatchResult::Error;
+		}
+	}
+	else if (RodinHasMagic(
+		         blob.data(),
+		         kFdtMagicBytes)) {
+		/*
+		 * Also support a plain FDT in case MagiskBoot exposes
+		 * the embedded DTB without the MediaTek wrapper.
+		 */
+		fdt_offset = 0;
+		fdt_length = blob.size();
+	}
+	else {
+		return RodinDtbPatchResult::NotFound;
+	}
+
+	void* fdt =
+		static_cast<void*>(
+			blob.data() + fdt_offset);
+
+	const int header_result =
+		fdt_check_header(fdt);
+
+	if (header_result != 0) {
+		LOGERR(
+			"Rodin DTB: libfdt rejected %s: %s\n",
+			path.c_str(),
+			fdt_strerror(header_result));
+
+		return RodinDtbPatchResult::Error;
+	}
+
+	const int fdt_total_size =
+		fdt_totalsize(fdt);
+
+	if (fdt_total_size <= 0 ||
+	    static_cast<size_t>(fdt_total_size) >
+	        fdt_length) {
+
+		LOGERR(
+			"Rodin DTB: invalid FDT size in %s\n",
+			path.c_str());
+
+		return RodinDtbPatchResult::Error;
+	}
+
+	const int node =
+		fdt_path_offset(
+			fdt,
+			kRodinUsbNode);
+
+	if (node == -FDT_ERR_NOTFOUND)
+		return RodinDtbPatchResult::NotFound;
+
+	if (node < 0) {
+		LOGERR(
+			"Rodin DTB: failed locating xHCI node in %s: %s\n",
+			path.c_str(),
+			fdt_strerror(node));
+
+		return RodinDtbPatchResult::Error;
+	}
+
+	if (!RodinCompatibleIsExpected(fdt, node)) {
+		LOGERR(
+			"Rodin DTB: unexpected xHCI compatible in %s\n",
+			path.c_str());
+
+		return RodinDtbPatchResult::Error;
+	}
+
+	int property_length = 0;
+
+	const void* property =
+		fdt_getprop(
+			fdt,
+			node,
+			kRodinUsbOffloadProperty,
+			&property_length);
+
+	if (!property) {
+		if (property_length == -FDT_ERR_NOTFOUND) {
+			LOGINFO(
+				"Rodin OTG DTB already safe: %s absent in %s\n",
+				kRodinUsbOffloadProperty,
+				path.c_str());
+
+			return RodinDtbPatchResult::Success;
+		}
+
+		LOGERR(
+			"Rodin DTB: unable to inspect %s in %s\n",
+			kRodinUsbOffloadProperty,
+			path.c_str());
+
+		return RodinDtbPatchResult::Error;
+	}
+
+	const int delete_result =
+		fdt_delprop(
+			fdt,
+			node,
+			kRodinUsbOffloadProperty);
+
+	if (delete_result != 0) {
+		LOGERR(
+			"Rodin DTB: failed deleting %s from %s: %s\n",
+			kRodinUsbOffloadProperty,
+			path.c_str(),
+			fdt_strerror(delete_result));
+
+		return RodinDtbPatchResult::Error;
+	}
+
+	int verify_length = 0;
+
+	if (fdt_getprop(
+		    fdt,
+		    node,
+		    kRodinUsbOffloadProperty,
+		    &verify_length) != nullptr ||
+	    verify_length != -FDT_ERR_NOTFOUND) {
+
+		LOGERR(
+			"Rodin DTB: %s still exists after deletion in %s\n",
+			kRodinUsbOffloadProperty,
+			path.c_str());
+
+		return RodinDtbPatchResult::Error;
+	}
+
+	if (fdt_check_header(fdt) != 0) {
+		LOGERR(
+			"Rodin DTB: FDT validation failed after edit: %s\n",
+			path.c_str());
+
+		return RodinDtbPatchResult::Error;
+	}
+
+	std::ofstream output(
+		path,
+		std::ios::binary |
+		std::ios::trunc);
+
+	if (!output ||
+	    !output.write(
+		    reinterpret_cast<const char*>(blob.data()),
+		    static_cast<std::streamsize>(blob.size()))) {
+
+		LOGERR(
+			"Rodin DTB: failed writing patched DTB: %s\n",
+			path.c_str());
+
+		return RodinDtbPatchResult::Error;
+	}
+
+	LOGINFO(
+		"Rodin OTG DTB patch: removed %s from %s:%s\n",
+		kRodinUsbOffloadProperty,
+		path.c_str(),
+		kRodinUsbNode);
+
+	return RodinDtbPatchResult::Success;
+}
+
+
+/*
+ * RODIN_DTB_REAL_DFE_FINAL
+ *
+ * Store the clean late fstab permanently inside vendor_boot DTB:
+ *
+ *     /fox_dfe/metadata
+ *
+ * Android exposes it at runtime as:
+ *
+ *     /proc/device-tree/fox_dfe/metadata
+ *
+ * Nothing is stored persistently on /data or /metadata.
+ */
+RodinDtbPatchResult RodinInjectDfeFstabDtbFile(
+        const std::string& path,
+        const std::string& dfe_fstab) {
+
+        std::ifstream input(
+                path,
+                std::ios::binary | std::ios::ate);
+
+        if (!input) {
+                LOGERR(
+                        "Auto-DFE DTB: cannot open %s\n",
+                        path.c_str());
+                return RodinDtbPatchResult::Error;
+        }
+
+        const std::streamoff end = input.tellg();
+
+        if (end <= 0 ||
+            end > 16 * 1024 * 1024) {
+                LOGERR(
+                        "Auto-DFE DTB: invalid DTB container size.\n");
+                return RodinDtbPatchResult::Error;
+        }
+
+        std::vector<uint8_t> blob(
+                static_cast<size_t>(end));
+
+        input.seekg(0, std::ios::beg);
+
+        input.read(
+                reinterpret_cast<char*>(blob.data()),
+                static_cast<std::streamsize>(blob.size()));
+
+        if (!input) {
+                LOGERR(
+                        "Auto-DFE DTB: failed reading %s\n",
+                        path.c_str());
+                return RodinDtbPatchResult::Error;
+        }
+
+        auto write_be32 =
+                [](uint8_t* q, uint32_t value) {
+                        q[0] =
+                                static_cast<uint8_t>(
+                                        value >> 24);
+                        q[1] =
+                                static_cast<uint8_t>(
+                                        value >> 16);
+                        q[2] =
+                                static_cast<uint8_t>(
+                                        value >> 8);
+                        q[3] =
+                                static_cast<uint8_t>(
+                                        value);
+                };
+
+        bool mediatek_wrapper = false;
+
+        size_t fdt_offset = 0;
+        size_t fdt_length = 0;
+
+        /*
+         * Plain FDT.
+         */
+        if (blob.size() >= 40 &&
+            fdt_check_header(blob.data()) == 0) {
+
+                fdt_offset = 0;
+                fdt_length = blob.size();
+        }
+
+        /*
+         * MediaTek wrapped FDT.
+         *
+         * Existing rodin parser already established:
+         *
+         *   total container size  BE32 @ +4
+         *   embedded FDT size     BE32 @ +32
+         *   embedded FDT offset   BE32 @ +36
+         */
+        else if (blob.size() >= 64) {
+
+                const uint32_t recorded_total =
+                        RodinReadBe32(
+                                blob.data() + 4);
+
+                const uint32_t embedded_length =
+                        RodinReadBe32(
+                                blob.data() + 32);
+
+                const uint32_t embedded_offset =
+                        RodinReadBe32(
+                                blob.data() + 36);
+
+                if (recorded_total != blob.size() ||
+                    embedded_offset < 64 ||
+                    embedded_length == 0 ||
+                    static_cast<size_t>(
+                            embedded_offset) +
+                            static_cast<size_t>(
+                                    embedded_length) >
+                            blob.size()) {
+
+                        LOGERR(
+                                "Auto-DFE DTB: invalid MediaTek container.\n");
+                        return RodinDtbPatchResult::Error;
+                }
+
+                if (fdt_check_header(
+                            blob.data() +
+                            embedded_offset) != 0) {
+
+                        LOGERR(
+                                "Auto-DFE DTB: embedded payload is not FDT.\n");
+                        return RodinDtbPatchResult::Error;
+                }
+
+                mediatek_wrapper = true;
+
+                fdt_offset =
+                        embedded_offset;
+
+                fdt_length =
+                        embedded_length;
+        }
+
+        else {
+                LOGERR(
+                        "Auto-DFE DTB: unsupported DTB format.\n");
+                return RodinDtbPatchResult::Error;
+        }
+
+
+        void* old_fdt =
+                static_cast<void*>(
+                        blob.data() +
+                        fdt_offset);
+
+        const int old_total =
+                fdt_totalsize(old_fdt);
+
+        if (old_total <= 0 ||
+            static_cast<size_t>(
+                    old_total) >
+                    fdt_length) {
+
+                LOGERR(
+                        "Auto-DFE DTB: invalid FDT size.\n");
+                return RodinDtbPatchResult::Error;
+        }
+
+
+        /*
+         * Make absolutely sure this is the rodin-compatible DTB.
+         */
+        const int rodin_node =
+                fdt_path_offset(
+                        old_fdt,
+                        kRodinUsbNode);
+
+        if (rodin_node < 0 ||
+            !RodinCompatibleIsExpected(
+                    old_fdt,
+                    rodin_node)) {
+
+                LOGERR(
+                        "Auto-DFE DTB: rodin-compatible DTB not found.\n");
+                return RodinDtbPatchResult::Error;
+        }
+
+
+        /*
+         * Grow with plenty of slack.
+         */
+        const size_t capacity =
+                static_cast<size_t>(
+                        old_total) +
+                dfe_fstab.size() +
+                32768;
+
+        if (capacity >
+            32ULL * 1024ULL * 1024ULL) {
+
+                LOGERR(
+                        "Auto-DFE DTB: expanded FDT too large.\n");
+                return RodinDtbPatchResult::Error;
+        }
+
+        std::vector<uint8_t> expanded(
+                capacity);
+
+        int rc =
+                fdt_open_into(
+                        old_fdt,
+                        expanded.data(),
+                        static_cast<int>(
+                                expanded.size()));
+
+        if (rc != 0) {
+                LOGERR(
+                        "Auto-DFE DTB: fdt_open_into: %s\n",
+                        fdt_strerror(rc));
+                return RodinDtbPatchResult::Error;
+        }
+
+
+        int dfe_node =
+                fdt_path_offset(
+                        expanded.data(),
+                        "/fox_dfe");
+
+        if (dfe_node ==
+            -FDT_ERR_NOTFOUND) {
+
+                dfe_node =
+                        fdt_add_subnode(
+                                expanded.data(),
+                                0,
+                                "fox_dfe");
+        }
+
+        if (dfe_node < 0) {
+                LOGERR(
+                        "Auto-DFE DTB: create /fox_dfe: %s\n",
+                        fdt_strerror(dfe_node));
+                return RodinDtbPatchResult::Error;
+        }
+
+
+        rc =
+                fdt_setprop(
+                        expanded.data(),
+                        dfe_node,
+                        "metadata",
+                        dfe_fstab.data(),
+                        static_cast<int>(
+                                dfe_fstab.size()));
+
+        if (rc != 0) {
+                LOGERR(
+                        "Auto-DFE DTB: set metadata property: %s\n",
+                        fdt_strerror(rc));
+                return RodinDtbPatchResult::Error;
+        }
+
+
+        rc =
+                fdt_pack(
+                        expanded.data());
+
+        if (rc != 0) {
+                LOGERR(
+                        "Auto-DFE DTB: fdt_pack: %s\n",
+                        fdt_strerror(rc));
+                return RodinDtbPatchResult::Error;
+        }
+
+
+        const int packed_size =
+                fdt_totalsize(
+                        expanded.data());
+
+        if (packed_size <= 0) {
+                LOGERR(
+                        "Auto-DFE DTB: packed FDT size invalid.\n");
+                return RodinDtbPatchResult::Error;
+        }
+
+
+        /*
+         * Verify exact carrier bytes.
+         */
+        int verify_length = 0;
+
+        const void* verify =
+                fdt_getprop(
+                        expanded.data(),
+                        dfe_node,
+                        "metadata",
+                        &verify_length);
+
+        if (verify == nullptr ||
+            verify_length !=
+                    static_cast<int>(
+                            dfe_fstab.size()) ||
+            memcmp(
+                    verify,
+                    dfe_fstab.data(),
+                    dfe_fstab.size()) != 0) {
+
+                LOGERR(
+                        "Auto-DFE DTB: carrier verification failed.\n");
+                return RodinDtbPatchResult::Error;
+        }
+
+
+        std::vector<uint8_t> output_blob;
+
+        if (!mediatek_wrapper) {
+
+                output_blob.assign(
+                        expanded.begin(),
+                        expanded.begin() +
+                                packed_size);
+        }
+
+        else {
+
+                const size_t old_payload_end =
+                        fdt_offset +
+                        fdt_length;
+
+                const size_t suffix_size =
+                        blob.size() -
+                        old_payload_end;
+
+                const size_t new_total =
+                        fdt_offset +
+                        static_cast<size_t>(
+                                packed_size) +
+                        suffix_size;
+
+                if (new_total >
+                    0xffffffffULL) {
+
+                        LOGERR(
+                                "Auto-DFE DTB: container exceeds 32-bit size.\n");
+                        return RodinDtbPatchResult::Error;
+                }
+
+
+                output_blob.resize(
+                        new_total);
+
+
+                /*
+                 * Preserve MediaTek header.
+                 */
+                memcpy(
+                        output_blob.data(),
+                        blob.data(),
+                        fdt_offset);
+
+
+                /*
+                 * New FDT.
+                 */
+                memcpy(
+                        output_blob.data() +
+                                fdt_offset,
+                        expanded.data(),
+                        static_cast<size_t>(
+                                packed_size));
+
+
+                /*
+                 * Preserve suffix if the wrapper has one.
+                 */
+                if (suffix_size != 0) {
+
+                        memcpy(
+                                output_blob.data() +
+                                        fdt_offset +
+                                        packed_size,
+                                blob.data() +
+                                        old_payload_end,
+                                suffix_size);
+                }
+
+
+                /*
+                 * Update MediaTek container sizes.
+                 */
+                write_be32(
+                        output_blob.data() + 4,
+                        static_cast<uint32_t>(
+                                new_total));
+
+                write_be32(
+                        output_blob.data() + 32,
+                        static_cast<uint32_t>(
+                                packed_size));
+
+                write_be32(
+                        output_blob.data() + 36,
+                        static_cast<uint32_t>(
+                                fdt_offset));
+        }
+
+
+        void* final_fdt =
+                output_blob.data() +
+                (mediatek_wrapper ?
+                        fdt_offset :
+                        0);
+
+        if (fdt_check_header(
+                    final_fdt) != 0) {
+
+                LOGERR(
+                        "Auto-DFE DTB: final FDT validation failed.\n");
+                return RodinDtbPatchResult::Error;
+        }
+
+
+        std::ofstream output(
+                path,
+                std::ios::binary |
+                std::ios::trunc);
+
+        if (!output ||
+            !output.write(
+                    reinterpret_cast<
+                            const char*>(
+                                    output_blob.data()),
+                    static_cast<
+                            std::streamsize>(
+                                    output_blob.size()))) {
+
+                LOGERR(
+                        "Auto-DFE DTB: failed writing %s\n",
+                        path.c_str());
