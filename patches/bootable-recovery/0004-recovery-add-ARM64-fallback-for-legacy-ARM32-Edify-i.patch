 	if (strlen(path) < 9 || strncmp(path, "/sideload", 9) != 0) {
@@ -348,7 +403,7 @@ int TWinstall_zip(const char *path, int *wipe_cache, bool check_for_digest)
 			gui_msg("verify_zip_done=Zip signature verified successfully.");
 		}
