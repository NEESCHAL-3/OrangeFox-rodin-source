@@ -476,6 +531,91 @@ int TWinstall_zip(const char *path, int *wipe_cache, bool check_for_digest)
   time(&stop);
   int total_time = (int) difftime(stop, start);
 
+  // Explicit request from the rodin permanent OrangeFox installer.
+  // The packaged recovery fragment is already LZ4-compressed. Preserve it
+  // byte-for-byte rather than rebuilding the live ramdisk through gzip.
+  if (ret_val == INSTALL_SUCCESS && reflashtwrp != 0)
+  {
+      const std::string fragment =
+          "/tmp/orangefox-permanent/"
+          "vendor_ramdisk_recovery.cpio";
+
+      std::string running_slot =
+          android::base::GetProperty(
+              "ro.boot.slot_suffix", "");
+
+      if (running_slot.empty())
+      {
+          running_slot =
+              android::base::GetProperty(
+                  "ro.boot.slot", "");
+      }
+
+      std::string target_slot;
+
+      if (running_slot == "_a" || running_slot == "a")
+      {
+          target_slot = "B";
+      }
+      else if (running_slot == "_b" || running_slot == "b")
+      {
+          target_slot = "A";
+      }
+
+      if (target_slot.empty())
+      {
+          gui_print_color(
+              "error",
+              "Unable to determine the permanent ROM slot.\n");
+          ret_val = INSTALL_ERROR;
+      }
+      else if (!TWFunc::Path_Exists(fragment))
+      {
+          gui_print_color(
+              "error",
+              "Packaged OrangeFox recovery fragment is missing.\n");
+          ret_val = INSTALL_ERROR;
+      }
+      else
+      {
+          gui_print(
+              "\nInstalling exact OrangeFox recovery fragment "
+              "into slot %s...\n",
+              target_slot.c_str());
+
+          PartitionManager.Override_Active_Slot(target_slot);
+          PartitionManager.Update_System_Details();
+          PartitionManager.Unlock_Block_Partitions();
+
+          Repack_Options_struct options{};
+          options.Type = REPLACE_RAMDISK_COMPRESSED;
+          options.Backup_First = false;
+          options.Disable_Verity = false;
+          options.Disable_Force_Encrypt = false;
+
+          twrpRepacker repacker;
+
+          if (!repacker.Repack_Image_And_Flash(
+                  fragment,
+                  options,
+                  false))
+          {
+              gui_print_color(
+                  "error",
+                  "OrangeFox permanent installation failed.\n");
+              ret_val = INSTALL_ERROR;
+          }
+          else
+          {
+              PartitionManager.Set_Active_Slot(target_slot);
+
+              gui_print(
+                  "OrangeFox permanently installed into slot %s.\n",
+                  target_slot.c_str());
+          }
+      }
+  }
+
   if (ret_val == INSTALL_CORRUPT)
     {
         set_miui_install_status(OTA_CORRUPT, true);
@@ -492,7 +632,7 @@ int TWinstall_zip(const char *path, int *wipe_cache, bool check_for_digest)
      if (Fox_Skip_OTA()) // yes
