-static int Run_Update_Binary(const char *path, int* wipe_cache, zip_type ztype) {
+
+// NEES rodin: old recovery ZIPs may ship an ARM32 Edify update-binary.
+// Cortex-A725 is AArch64-only, so detect those binaries and execute the
+// recovery's native ARM64 updater with the same API/pipe/ZIP arguments.
+static bool Is_Legacy_ARM32_Update_Binary(const char* path) {
+	unsigned char hdr[20] = {};
+	int fd = open(path, O_RDONLY | O_CLOEXEC);
+	if (fd < 0)
+		return false;
+
+	ssize_t n = read(fd, hdr, sizeof(hdr));
+	close(fd);
+
+	// ELF magic, ELFCLASS32, little-endian, e_machine == EM_ARM (40 / 0x28).
+	return n == static_cast<ssize_t>(sizeof(hdr)) &&
+		hdr[0] == 0x7f && hdr[1] == 'E' && hdr[2] == 'L' && hdr[3] == 'F' &&
+		hdr[4] == 1 && hdr[5] == 1 &&
+		hdr[18] == 0x28 && hdr[19] == 0x00;
+}
+
+static int Run_Update_Binary(const char *path, int* wipe_cache, zip_type ztype, int* request_reflash) {
 	int ret_val, pipe_fd[2], status, zip_verify;
 	int aroma_running = 0;
 	char buffer[1024];
@@ -189,7 +210,36 @@ static int Run_Update_Binary(const char *path, int* wipe_cache, zip_type ztype)
         return ret_val;
     }
 
-	// Convert the vector to a NULL-terminated char* array suitable for execv.
+
+	// rodin has no AArch32 execution support. For old Edify ZIPs that bundle
+	// a 32-bit ARM update-binary, keep the standard updater arguments but
+	// execute our native ARM64 updater instead.
+	if (ztype == UPDATE_BINARY_ZIP_TYPE &&
+	    Is_Legacy_ARM32_Update_Binary(TMP_UPDATER_BINARY_PATH)) {
+		const char* builtin_updater = "/system/bin/updater";
+
+		if (access(builtin_updater, X_OK) != 0) {
+			gui_print_color("error",
+				"Legacy ARM32 ZIP detected, but ARM64 recovery updater is missing.\n");
+			close(pipe_fd[0]);
+			close(pipe_fd[1]);
+			return INSTALL_ERROR;
+		}
+
+		if (args.empty()) {
+			LOGERR("Updater argument vector is empty\n");
+			close(pipe_fd[0]);
+			close(pipe_fd[1]);
+			return INSTALL_ERROR;
+		}
+
+		LOGINFO("Legacy ARM32 update-binary detected; using %s\n",
+			builtin_updater);
+		gui_print("Legacy ARM32 installer detected; using OrangeFox ARM64 Edify updater.\n");
+		args[0] = builtin_updater;
+	}
+
+// Convert the vector to a NULL-terminated char* array suitable for execv.
 	const char* chr_args[args.size() + 1];
 	chr_args[args.size()] = NULL;
 	for (size_t i = 0; i < args.size(); i++)
@@ -205,6 +255,7 @@ static int Run_Update_Binary(const char *path, int* wipe_cache, zip_type ztype)
