@@ -445,7 +500,7 @@ int TWinstall_zip(const char *path, int *wipe_cache, bool check_for_digest)
 
 			TWFunc::IsRecoveryOverwritten(true);
 
-			ret_val = Run_Update_Binary(path, wipe_cache, AB_OTA_ZIP_TYPE);
+			ret_val = Run_Update_Binary(path, wipe_cache, AB_OTA_ZIP_TYPE, &reflashtwrp);
 
